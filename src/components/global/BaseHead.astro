---
import '../../styles/global.css';
import { AstroSeo } from '@astrolib/seo';
---

<!-- Core meta tags -->
<meta charset='UTF-8' />
<meta http-equiv='X-UA-Compatible' content='IE=edge' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1, maximum-scale=1'
/>
<meta name='author' content='Abdullah Sultan' />
<!-- student builder -->

<!-- SEO Configuration - customize these values -->
<AstroSeo
  title={Astro.props.title || 'Abdullah Sultan - student builder'}
  description={Astro.props.description ||
    'student builder based in Riyadh, Saudi Arabia specializing in systematic trading strategies and scalable infrastructure'}
  canonical={Astro.props.canonical || 'https://abdullahmsultan.me'}
  openGraph={{
    url: Astro.props.openGraph?.url || 'https://abdullahmsultan.me',
    title: Astro.props.openGraph?.title || 'Abdullah Sultan - student builder',
    description:
      Astro.props.openGraph?.description ||
      'student builder based in Riyadh, Saudi Arabia specializing in systematic trading strategies and scalable infrastructure',
    images: [
      {
        url: 'https://abdullahmsultan.me/og.jpg',
        width: 1200,
        height: 630,
        alt: 'Abdullah Sultan portfolio'
      },
    ],
    site_name: Astro.props.openGraph?.site_name || 'Abdullah Sultan',
  }}
/>


<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={Astro.props.title || 'Abdullah Sultan - student builder'} />
<meta name="twitter:description" content={Astro.props.description || 'student builder based in Riyadh, Saudi Arabia.'} />
<meta name="twitter:image" content="https://abdullahmsultan.me/og.jpg" />

<!-- JSON-LD Person schema -->
<script type="application/ld+json">
  {JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Abdullah Sultan',
    url: 'https://abdullahmsultan.me',
    email: 'mailto:abdullahmsultan1@gmail.com',
    jobTitle: 'Student Builder',
    address: { '@type': 'PostalAddress', addressLocality: 'Riyadh', addressCountry: 'SA' },
    sameAs: [
      'https://abdullahmsultan.me',
      'https://www.linkedin.com/in/abdullah-sultan-4a264939a/',
    ],
  })}
</script>

<!-- Optimized favicon -->
<link rel='apple-touch-icon' sizes='180x180' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='152x152' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='144x144' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='120x120' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='114x114' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='76x76' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='72x72' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='60x60' href='/icons/abdullah-apple-touch.png' />
<link rel='apple-touch-icon' sizes='57x57' href='/icons/abdullah-apple-touch.png' />
<link
  rel='icon'
  type='image/png'
  sizes='96x96'
  href='/icons/abdullah-favicon.png'
/>
<link
  rel='icon'
  type='image/png'
  sizes='32x32'
  href='/icons/abdullah-favicon.png'
/>
<link
  rel='icon'
  type='image/png'
  sizes='16x16'
  href='/icons/abdullah-favicon.png'
/>
<link rel='shortcut icon' href='/icons/abdullah-favicon.png' />

<!-- Theme colors for browsers -->
<meta name='msapplication-TileColor' content='#0e1116' />
<meta name='theme-color' content='#0e1116' />

<!-- Auto-generated sitemap -->
<link rel='sitemap' href='/sitemap-index.xml' />

<!-- Mono utility for labels / status -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

<!-- Preload display fonts + portrait -->
<link rel='preload' href='/NeueMontreal-Medium.otf' as='font' type='font/otf' crossorigin />
<link rel='preload' href='/images/myimage.jpg' as='image' type='image/jpeg' fetchpriority='high' />
