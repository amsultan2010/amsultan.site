---
import ASeparator from './ASeparator.astro';
---

<section class="s-hero" aria-label="introduction">
  <div class="s-hero__meta vf-mono">
    <span>student builder</span>
    <span aria-hidden="true">·</span>
    <span>riyadh</span>
    <span aria-hidden="true">·</span>
    <span class="js-clock">--:--</span>
  </div>

  <ASeparator phrases={['tutoring', 'f1', 'quant', 'riyadh']} />

  <div class="s-hero__stage js-hero-stage">
    <h1 class="s-hero__title vf-display js-hero-title">
      <span class="s-hero__line js-hero-line">abdullah</span>
      <span class="s-hero__star js-hero-star" aria-hidden="true">★</span>
      <span class="s-hero__line js-hero-line">sultan</span>
    </h1>
  </div>

  <ASeparator phrases={['tutoringbyabdullah', 'downforce', 'quantpy', 'x-combinator']} reverse />

  <p class="s-hero__lede vf-serif">
    tutoring, f1 media, and quant tools. open to coffee chats.
  </p>

  <div class="s-hero__actions vf-mono">
    <a href="mailto:abdullahmsultan1@gmail.com" class="s-hero__btn s-hero__btn--solid js-magnetic js-scramble">grab coffee</a>
    <a href="#work" class="s-hero__btn js-magnetic js-scramble">see work</a>
  </div>

  <p class="s-hero__scroll vf-mono js-scroll-cue" aria-hidden="true">scroll</p>
</section>

<style>
  .s-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5.5rem 0 6vh;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .s-hero__meta {
    padding: 0 var(--vf-pad) 0.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
  }
  .s-hero__stage {
    perspective: 1200px;
    transform-style: preserve-3d;
    width: 100%;
  }
  .s-hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.08em 0.18em;
    margin: 0.5rem 0;
    padding: 0 0.5rem;
    font-size: clamp(3.2rem, 14vw, 9.5rem);
    text-align: center;
    will-change: transform;
    transform-style: preserve-3d;
    max-width: 100%;
  }
  .s-hero__line {
    display: inline-flex;
    overflow: visible;
  }
  .s-hero__char {
    display: inline-block;
    will-change: transform;
  }
  .s-hero__star {
    color: var(--vf-mark);
    font-size: 0.42em;
    line-height: 1;
    transform: translateY(0.12em);
    display: inline-block;
    will-change: transform;
  }
  .s-hero__lede {
    max-width: 34rem;
    margin: 1.25rem auto 0;
    padding: 0 var(--vf-pad);
    text-align: center;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .s-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding: 0 var(--vf-pad);
    width: 100%;
  }
  .s-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    min-width: 10rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--vf-ink);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.08em;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .s-hero__btn:hover {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: var(--vf-field);
  }
  .s-hero__scroll {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }

  @media (max-width: 720px) {
    .s-hero {
      min-height: auto;
      padding: 1.25rem 0 3.5rem;
      justify-content: flex-start;
    }
    .s-hero__title {
      font-size: clamp(2.8rem, 16vw, 4.5rem);
    }
    .s-hero__lede {
      font-size: 1.3rem;
      max-width: 22rem;
    }
    .s-hero__actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 20rem;
      margin-left: auto;
      margin-right: auto;
      gap: 0.65rem;
    }
    .s-hero__btn {
      width: 100%;
      min-height: 3.4rem;
      font-size: 1.05rem;
    }
    .s-hero__scroll {
      display: none;
    }
  }
</style>
