---
import ASeparator from './ASeparator.astro';
---

<section class="s-hero" aria-label="Introduction">
  <div class="s-hero__status vf-mono">riyadh · shipping · student builder</div>

  <ASeparator phrases={['abdullah', 'sultan', '////', 'ship', 'prove', '####']} />

  <h1 class="s-hero__title vf-display">
    <span class="s-hero__word js-hero-word">Abdullah</span>
    <span class="s-hero__star" aria-hidden="true">★</span>
    <span class="s-hero__word js-hero-word">Sultan</span>
  </h1>

  <ASeparator phrases={['tutoring', 'f1', 'quant', 'agents', '////', 'build']} />

  <p class="s-hero__lede vf-serif">
    shipping tutoring, f1 media, and agent tools — looking for coffee chats with builders.
  </p>

  <div class="s-hero__actions vf-mono">
    <a href="#work" class="s-hero__btn s-hero__btn--mark">see work</a>
    <a href="#contact" class="s-hero__btn">talk</a>
  </div>
</section>

<style>
  .s-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 8vh;
    position: relative;
    overflow: hidden;
  }
  .s-hero__status {
    padding: 0 1.25rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--vf-mark);
  }
  .s-hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.15em 0.25em;
    margin: 0.75rem 0;
    padding: 0 0.75rem;
    font-size: clamp(3.2rem, 14vw, 9.5rem);
    text-align: center;
    overflow: hidden;
  }
  .s-hero__word {
    display: inline-flex;
    overflow: hidden;
  }
  .s-hero__char {
    display: inline-block;
    will-change: transform;
  }
  .s-hero__star {
    color: var(--vf-mark);
    font-size: 0.45em;
    line-height: 1;
    transform: translateY(0.15em);
  }
  .s-hero__lede {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem;
    text-align: center;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.45;
  }
  .s-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding: 0 1.25rem;
  }
  .s-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--vf-ink);
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .s-hero__btn:hover {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--mark {
    background: var(--vf-ink);
    border-color: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--mark:hover {
    background: transparent;
    color: var(--vf-ink);
  }
</style>
