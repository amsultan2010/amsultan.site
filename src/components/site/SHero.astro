---
import ASeparator from './ASeparator.astro';
---

<section class="s-hero" aria-label="introduction">
  <div class="s-hero__meta vf-mono">
    <span>student builder</span>
    <span aria-hidden="true">·</span>
    <span>riyadh</span>
    <span aria-hidden="true">·</span>
    <span class="js-clock">--:--</span>
  </div>

  <ASeparator phrases={['tutoring', 'f1', 'quant', 'lab', 'riyadh']} />

  <h1 class="s-hero__title vf-display">
    <span class="s-hero__line js-hero-line">abdullah</span>
    <span class="s-hero__star" aria-hidden="true">★</span>
    <span class="s-hero__line js-hero-line">sultan</span>
  </h1>

  <ASeparator phrases={['tutoringbyabdullah', 'downforce', 'quantpy', 'x-combinator']} />

  <p class="s-hero__lede vf-serif">
    shipping tutoring, f1 media, and agent tools. looking for coffee chats with builders.
  </p>

  <div class="s-hero__actions vf-mono">
    <a href="mailto:abdullahmsultan1@gmail.com" class="s-hero__btn s-hero__btn--solid">grab coffee</a>
    <a href="#work" class="s-hero__btn">see work</a>
  </div>
</section>

<style>
  .s-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 8vh;
    position: relative;
    overflow: hidden;
  }
  .s-hero__meta {
    padding: 0 var(--vf-pad) 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.12em 0.22em;
    margin: 0.5rem 0;
    padding: 0 0.75rem;
    font-size: clamp(3.4rem, 14vw, 9.5rem);
    text-align: center;
    will-change: transform;
  }
  .s-hero__line {
    display: inline-flex;
    overflow: visible;
  }
  .s-hero__char {
    display: inline-block;
    will-change: transform;
  }
  .s-hero__star {
    color: var(--vf-mark);
    font-size: 0.42em;
    line-height: 1;
    transform: translateY(0.12em);
    display: inline-block;
    will-change: transform;
  }
  .s-hero__lede {
    max-width: 34rem;
    margin: 1.35rem auto 0;
    padding: 0 var(--vf-pad);
    text-align: center;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.45;
  }
  .s-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding: 0 var(--vf-pad);
  }
  .s-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--vf-ink);
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .s-hero__btn:hover {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid:hover {
    background: transparent;
    color: var(--vf-ink);
  }
</style>
