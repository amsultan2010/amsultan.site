---
import ASeparator from './ASeparator.astro';
---

<section class="s-hero" aria-label="introduction">
  <div class="s-hero__meta vf-mono">
    <span>student builder</span>
    <span aria-hidden="true">·</span>
    <span>riyadh</span>
    <span aria-hidden="true">·</span>
    <span class="js-clock">--:--</span>
  </div>

  <ASeparator phrases={['tutoring', 'f1', 'quant', 'riyadh']} />

  <div class="s-hero__stage js-hero-stage">
    <h1 class="s-hero__title vf-display js-hero-title">
      <span class="s-hero__line js-hero-line">abdullah</span>
      <span class="s-hero__star js-hero-star" aria-hidden="true">★</span>
      <span class="s-hero__line js-hero-line">sultan</span>
    </h1>
  </div>

  <ASeparator phrases={['tutoringbyabdullah', 'downforce', 'quantpy', 'x-combinator']} reverse />

  <p class="s-hero__lede vf-serif">
    tutoring, f1 media, and quant tools. open to coffee chats.
  </p>

  <div class="s-hero__actions vf-mono">
    <a href="mailto:abdullahmsultan1@gmail.com" class="s-hero__btn s-hero__btn--glow js-magnetic js-scramble">grab coffee</a>
    <a href="#work" class="s-hero__btn js-magnetic js-scramble">see work</a>
  </div>

  <p class="s-hero__scroll vf-mono js-scroll-cue" aria-hidden="true">scroll</p>
</section>

<style>
  .s-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 0 12vh;
    position: relative;
    overflow: hidden;
  }
  .s-hero__meta {
    padding: 0 var(--vf-pad) 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-hero__stage {
    perspective: 1200px;
    transform-style: preserve-3d;
  }
  .s-hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.08em 0.18em;
    margin: 0.35rem 0;
    padding: 0 0.5rem;
    font-size: clamp(2.8rem, 13vw, 9.2rem);
    text-align: center;
    will-change: transform;
    transform-style: preserve-3d;
    max-width: 100%;
  }
  .s-hero__line {
    display: inline-flex;
    overflow: visible;
  }
  .s-hero__char {
    display: inline-block;
    will-change: transform;
  }
  .s-hero__star {
    color: var(--vf-mark);
    font-size: 0.42em;
    line-height: 1;
    transform: translateY(0.12em);
    display: inline-block;
    will-change: transform;
    filter: drop-shadow(0 0 12px var(--vf-glow));
  }
  .s-hero__lede {
    max-width: 32rem;
    margin: 1.6rem auto 0;
    padding: 0 var(--vf-pad);
    text-align: center;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
    color: color-mix(in srgb, var(--vf-ink) 88%, transparent);
  }
  .s-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.1rem;
    padding: 0 var(--vf-pad);
  }
  .s-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    min-width: 9.5rem;
    padding: 0.95rem 1.5rem;
    border: 1px solid var(--vf-ink);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    transition: background 0.25s, color 0.25s, border-color 0.25s, box-shadow 0.25s, transform 0.2s;
  }
  .s-hero__btn:hover {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--glow {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: #fffaf5;
    box-shadow: 0 0 0 transparent;
  }
  .s-hero__btn--glow:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: #fffaf5;
    box-shadow: 0 0 22px var(--vf-glow);
  }
  .s-hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
  }
</style>
