---

<section class="s-hero" aria-label="introduction">
  <div class="s-hero__meta vf-mono">
    <span>student builder</span>
    <span aria-hidden="true">·</span>
    <span>riyadh</span>
    <span aria-hidden="true">·</span>
    <span class="js-clock">--:--</span>
  </div>

  <div class="s-hero__stage js-hero-stage">
    <h1 class="s-hero__title vf-display js-hero-title">
      <span class="s-hero__line js-hero-line">abdullah</span>
      <span class="s-hero__star js-hero-star" aria-hidden="true">★</span>
      <span class="s-hero__line js-hero-line">sultan</span>
    </h1>
  </div>

  <p class="s-hero__lede vf-serif js-fade-up">
    tutoring, f1 media, and quant tools. open to coffee chats.
  </p>

  <div class="s-hero__actions vf-mono js-fade-up">
    <a href="mailto:abdullahmsultan1@gmail.com" class="s-hero__btn s-hero__btn--solid">grab coffee</a>
    <a href="#work" class="s-hero__btn">see work</a>
  </div>

  <p class="s-hero__scroll vf-mono js-scroll-cue" aria-hidden="true">scroll</p>
</section>

<style>
  .s-hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem var(--vf-pad) 14vh;
    position: relative;
    overflow: hidden;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
    margin-bottom: 1.5rem;
  }
  .s-hero__stage {
    perspective: 1000px;
  }
  .s-hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.08em 0.18em;
    margin: 0;
    font-size: clamp(3rem, 12vw, 7.5rem);
    will-change: transform;
    max-width: 12ch;
  }
  .s-hero__line {
    display: inline-flex;
  }
  .s-hero__char {
    display: inline-block;
    will-change: transform;
  }
  .s-hero__star {
    color: var(--vf-mark);
    font-size: 0.38em;
    line-height: 1;
    display: inline-block;
    transform: translateY(0.08em);
  }
  .s-hero__lede {
    max-width: 28rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.5;
  }
  .s-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .s-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    min-width: 9rem;
    padding: 0.85rem 1.35rem;
    border: 1px solid var(--vf-ink);
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    transition: background 0.3s var(--vf-ease), color 0.3s var(--vf-ease), border-color 0.3s var(--vf-ease);
  }
  .s-hero__btn:hover {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid {
    background: var(--vf-ink);
    color: var(--vf-field);
  }
  .s-hero__btn--solid:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: var(--vf-field);
  }
  .s-hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    left: var(--vf-pad);
    margin: 0;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    opacity: 0.5;
  }
</style>
