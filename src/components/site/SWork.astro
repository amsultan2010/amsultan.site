---
import { PROJECTS } from '../../data/projects';

const featured = PROJECTS;
const total = String(featured.length).padStart(2, '0');
---

<section id="work" class="s-work js-work" aria-label="work">
  <div class="s-work__head">
    <a href="/projects" class="s-work__all vf-mono js-magnetic">full archive →</a>
  </div>

  <div class="s-work__viewport">
    <div class="s-work__track js-work-track">
      {featured.map((project, i) => {
        const href = project.demo || project.href;
        const external = href.startsWith('http');
        const serial = `${String(i + 1).padStart(2, '0')} / ${total}`;
        return (
          <article class="s-work__item js-work-item">
            <div class="s-work__meta vf-mono">
              <span>{serial}</span>
              <span>{project.period}</span>
            </div>
            <a
              class="s-work__media"
              href={href}
              target={external || project.demoNewTab ? '_blank' : undefined}
              rel={external || project.demoNewTab ? 'noopener noreferrer' : undefined}
            >
              <img src={project.cover} alt="" loading="lazy" />
            </a>
            <div class="s-work__copy">
              <p class="s-work__role vf-mono">{project.role}</p>
              <h3 class="s-work__name vf-display">
                <a href={href} target={external || project.demoNewTab ? '_blank' : undefined} rel={external || project.demoNewTab ? 'noopener noreferrer' : undefined}>
                  {project.title}
                </a>
              </h3>
              <p class="s-work__desc vf-serif">{project.desc}</p>
              {project.metrics && (
                <ul class="s-work__metrics vf-mono">
                  {project.metrics.slice(0, 2).map((m) => <li>{m}</li>)}
                </ul>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .s-work {
    padding: 1vh 0 10vh;
    overflow-x: clip;
  }
  .s-work__head {
    display: flex;
    justify-content: flex-end;
    padding: 0 var(--vf-pad) 1.25rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-work__all {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--vf-ink);
    border-bottom: 1px solid var(--vf-ink);
    padding: 0.35rem 0;
    transition: color 0.25s var(--vf-ease), border-color 0.25s var(--vf-ease);
  }
  .s-work__all:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-work__viewport {
    overflow: hidden;
  }
  .s-work__track {
    display: flex;
    gap: 1.75rem;
    padding: 0.5rem var(--vf-pad) 2.5rem;
    width: max-content;
    will-change: transform;
  }
  .s-work__item {
    flex: 0 0 min(78vw, 360px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    min-width: 0;
  }
  .s-work__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }
  .s-work__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--vf-line);
    background: color-mix(in srgb, var(--vf-ink) 6%, transparent);
    display: block;
  }
  .s-work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--vf-ease);
  }
  .s-work__item:hover .s-work__media img {
    transform: scale(1.04);
  }
  .s-work__copy {
    min-width: 0;
    display: grid;
    gap: 0.35rem;
  }
  .s-work__role {
    margin: 0;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--vf-mark);
  }
  .s-work__name {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .s-work__name a {
    text-decoration: none;
  }
  .s-work__name a:hover {
    color: var(--vf-mark);
  }
  .s-work__desc {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  .s-work__metrics {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .s-work__metrics li {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--vf-mark);
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .s-work__metrics li::before {
    content: '· ';
  }
  @media (max-width: 767px) {
    .s-work__track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .s-work__item {
      scroll-snap-align: start;
      flex-basis: min(86vw, 340px);
    }
  }
</style>
