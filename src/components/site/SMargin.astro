---
import fs from 'node:fs';
import path from 'node:path';
import { photos } from '../../data/photos';

const asciiPath = path.join(process.cwd(), 'public/images/myascii.txt');
const ascii = fs.existsSync(asciiPath)
  ? fs.readFileSync(asciiPath, 'utf8').trimEnd()
  : 'abdullah';
---

<section id="margin" class="s-margin" aria-label="photos">
  <div class="s-margin__layout">
    <article class="s-margin__ascii js-margin-card">
      <p class="vf-mono s-margin__label">ascii</p>
      <div class="s-margin__ascii-frame">
        <pre class="s-margin__pre">{ascii}</pre>
      </div>
    </article>

    <div class="s-margin__grid">
      {photos.map((photo, i) => (
        <article
          class="s-margin__card js-margin-card"
          style={`--rot: ${(i % 2 === 0 ? -1 : 1) * (1 + (i % 3) * 0.6)}deg`}
        >
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .s-margin {
    padding: 1vh 0 10vh;
    overflow-x: clip;
  }
  .s-margin__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 1rem;
    padding: 0.5rem var(--vf-pad) 1rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-margin__ascii {
    border: 1px solid var(--vf-line);
    border-radius: 1.1rem;
    padding: 0.65rem;
    background: color-mix(in srgb, var(--vf-field) 55%, #fff);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--vf-ink) 5%, transparent);
    min-width: 0;
    container-type: inline-size;
    align-self: start;
  }
  .s-margin__label {
    margin: 0 0 0.45rem;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--vf-mark);
  }
  .s-margin__ascii-frame {
    overflow: hidden;
    width: 100%;
  }
  .s-margin__pre {
    margin: 0;
    font-family: var(--vf-font-mono);
    font-size: 1.05cqi;
    line-height: 1.05;
    color: var(--vf-ink);
    opacity: 0.9;
    white-space: pre;
    width: max-content;
    max-width: none;
  }
  .s-margin__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 0.45rem;
    align-content: start;
  }
  .s-margin__card {
    border: 1px solid var(--vf-line);
    border-radius: 0.55rem;
    padding: 0.2rem;
    background: color-mix(in srgb, var(--vf-field) 55%, #fff);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.3s ease;
    overflow: hidden;
    min-width: 0;
  }
  .s-margin__card:hover {
    transform: rotate(0deg) scale(1.08);
    z-index: 2;
  }
  .s-margin__card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    filter: grayscale(0.08) contrast(1.05);
  }

  @media (max-width: 900px) {
    .s-margin__layout {
      grid-template-columns: 1fr;
    }
    .s-margin__grid {
      grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    }
  }
  @media (max-width: 520px) {
    .s-margin__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .s-margin__card {
      transform: none;
    }
  }
</style>
