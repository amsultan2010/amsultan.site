---
import fs from 'node:fs';
import path from 'node:path';
import { photos } from '../../data/photos';

const asciiPath = path.join(process.cwd(), 'public/images/myascii.txt');
const ascii = fs.existsSync(asciiPath)
  ? fs.readFileSync(asciiPath, 'utf8').trimEnd()
  : 'abdullah';
---

<section id="margin" class="s-margin" aria-label="photos">
  <div class="s-margin__layout">
    <article class="s-margin__ascii js-margin-card">
      <p class="vf-mono s-margin__label">ascii</p>
      <div class="s-margin__ascii-frame">
        <pre class="s-margin__pre">{ascii}</pre>
      </div>
    </article>

    <div class="s-margin__grid">
      {photos.map((photo, i) => (
        <article
          class={`s-margin__card js-margin-card ${i % 7 === 0 ? 's-margin__card--wide' : ''} ${i % 11 === 3 ? 's-margin__card--tall' : ''}`}
          style={`--rot: ${(i % 2 === 0 ? -1 : 1) * (1.2 + (i % 3) * 0.7)}deg`}
        >
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .s-margin {
    padding: 1vh 0 5vh;
    overflow-x: clip;
    text-align: left;
  }
  .s-margin__layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.8fr);
    gap: 1.5rem;
    padding: 0.5rem var(--vf-pad) 1rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    margin: 0 auto;
    align-items: start;
  }
  .s-margin__ascii {
    border: 1px solid var(--vf-line);
    padding: 1rem;
    background: color-mix(in srgb, var(--vf-ink) 6%, transparent);
    min-width: 0;
    width: 100%;
    max-width: none;
    container-type: inline-size;
    position: sticky;
    top: 6.5rem;
  }
  .s-margin__label {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
    text-align: center;
  }
  .s-margin__ascii-frame {
    overflow: hidden;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .s-margin__pre {
    margin: 0;
    font-family: var(--vf-font-mono);
    font-size: 1.2cqi;
    line-height: 1.05;
    color: var(--vf-ink);
    opacity: 0.9;
    white-space: pre;
    width: max-content;
    max-width: none;
    text-align: left;
  }
  .s-margin__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    align-content: start;
    width: 100%;
  }
  .s-margin__card {
    --rx: 0deg;
    --ry: 0deg;
    border: 1px solid var(--vf-line);
    padding: 0.35rem;
    background: color-mix(in srgb, var(--vf-ink) 4%, transparent);
    transform: rotate(var(--rot, 0deg)) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s;
    overflow: hidden;
    min-width: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .s-margin__card--wide {
    grid-column: span 2;
  }
  .s-margin__card--tall {
    grid-row: span 2;
    height: 100%;
  }
  .s-margin__card:hover {
    transform: rotate(0deg) rotateX(0deg) rotateY(0deg) scale(1.04);
    z-index: 2;
    border-color: color-mix(in srgb, var(--vf-mark) 55%, var(--vf-line));
  }
  .s-margin__card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    filter: grayscale(0.05) contrast(1.06);
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s;
  }
  .s-margin__card--tall img {
    height: 100%;
    aspect-ratio: auto;
    min-height: 100%;
    object-fit: cover;
  }
  .s-margin__card:hover img {
    transform: scale(1.08);
    filter: grayscale(0) contrast(1.08);
  }

  @media (max-width: 1100px) {
    .s-margin__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .s-margin__layout {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }
    .s-margin__ascii {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .s-margin__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .s-margin__card--wide,
    .s-margin__card--tall {
      grid-column: span 1;
      grid-row: span 1;
    }
    .s-margin__card {
      transform: none;
    }
    .s-margin__card:hover {
      transform: none;
    }
  }
</style>
