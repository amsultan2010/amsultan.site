---
import { photos } from '../../data/photos';

const picks = photos.slice(0, 6);
---

<section id="margin" class="s-margin" aria-label="photos">
  <div class="s-margin__grid">
    <article class="s-margin__ascii js-margin-card">
      <p class="vf-mono s-margin__label">ascii</p>
      <pre class="s-margin__pre" data-ascii-src="/images/myascii.txt">loading…</pre>
    </article>

    {picks.map((photo, i) => (
      <article
        class={`s-margin__card js-margin-card s-margin__card--${(i % 3) + 1}`}
        style={`--rot: ${(i % 2 === 0 ? -1 : 1) * (2 + (i % 3))}deg`}
      >
        <img src={photo.src} alt={photo.alt} loading="lazy" />
      </article>
    ))}
  </div>
</section>

<script>
  const pre = document.querySelector<HTMLElement>('.s-margin__pre');
  if (pre) {
    const src = pre.dataset.asciiSrc;
    if (src) {
      fetch(src)
        .then((r) => r.text())
        .then((t) => {
          pre.textContent = t.trimEnd().split('\n').slice(0, 36).join('\n');
        })
        .catch(() => {
          pre.textContent = 'abdullah';
        });
    }
  }
</script>

<style>
  .s-margin {
    padding: 1vh 0 10vh;
    overflow-x: clip;
  }
  .s-margin__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.85rem;
    padding: 0.5rem var(--vf-pad) 1rem;
  }
  .s-margin__ascii {
    grid-column: span 5;
    border: 1px solid var(--vf-line);
    padding: 0.75rem;
    background: color-mix(in srgb, var(--vf-ink) 6%, transparent);
    min-height: 240px;
    min-width: 0;
  }
  .s-margin__label {
    margin: 0 0 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--vf-mark);
  }
  .s-margin__pre {
    margin: 0;
    font-family: var(--vf-font-mono);
    font-size: 5px;
    line-height: 1.05;
    overflow: hidden;
    max-height: 280px;
    color: var(--vf-ink);
    opacity: 0.85;
    white-space: pre;
  }
  .s-margin__card {
    grid-column: span 3;
    border: 1px solid var(--vf-line);
    padding: 0.4rem;
    background: color-mix(in srgb, var(--vf-ink) 4%, transparent);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.35s ease;
    overflow: hidden;
    min-width: 0;
  }
  .s-margin__card:hover {
    transform: rotate(0deg) scale(1.04);
    z-index: 2;
  }
  .s-margin__card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    filter: grayscale(0.1) contrast(1.05);
  }
  .s-margin__card--1 { grid-column: span 4; }
  .s-margin__card--2 { grid-column: span 3; }
  .s-margin__card--3 { grid-column: span 4; }

  @media (max-width: 900px) {
    .s-margin__ascii { grid-column: span 12; }
    .s-margin__card,
    .s-margin__card--1,
    .s-margin__card--2,
    .s-margin__card--3 {
      grid-column: span 6;
    }
  }
  @media (max-width: 520px) {
    .s-margin__card,
    .s-margin__card--1,
    .s-margin__card--2,
    .s-margin__card--3 {
      grid-column: span 12;
      transform: none;
    }
  }
</style>
