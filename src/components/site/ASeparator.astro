---
interface Props {
  phrases?: string[];
  class?: string;
}
const {
  phrases = ['ship', 'prove', 'repeat', '####', '////', 'ascii', 'build'],
  class: className = '',
} = Astro.props;

const strip = Array.from({ length: 24 }, (_, i) => phrases[i % phrases.length]).join('  ·  ');
---

<div class={`a-sep ${className}`} aria-hidden="true">
  <div class="a-sep__track vf-mono">{strip}  ·  {strip}</div>
</div>

<style>
  .a-sep {
    overflow: hidden;
    border: none;
    background: transparent;
    color: var(--vf-mark);
    padding: 1.25rem 0;
    user-select: none;
    transform-origin: center;
  }
  .a-sep__track {
    white-space: nowrap;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    animation: sep-marquee 28s linear infinite;
    width: max-content;
  }
  @keyframes sep-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sep__track { animation: none; }
  }
</style>
