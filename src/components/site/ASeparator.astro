---
interface Props {
  phrases?: string[];
  class?: string;
  reverse?: boolean;
}
const {
  phrases = ['tutoring', 'f1', 'quant', 'riyadh'],
  class: className = '',
  reverse = false,
} = Astro.props;

const strip = Array.from({ length: 28 }, (_, i) => phrases[i % phrases.length]).join('  ·  ');
---

<div class={`a-sep js-sep ${reverse ? 'a-sep--reverse' : ''} ${className}`} aria-hidden="true">
  <div class="a-sep__track vf-mono">{strip}  ·  {strip}</div>
</div>

<style>
  .a-sep {
    overflow: hidden;
    border: none;
    background: transparent;
    color: var(--vf-mark);
    padding: 0.85rem 0;
    user-select: none;
    transform-origin: center;
    border-block: 1px solid color-mix(in srgb, var(--vf-ink) 16%, transparent);
    text-align: center;
  }
  .a-sep__track {
    white-space: nowrap;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    animation: sep-marquee 26s linear infinite;
    width: max-content;
  }
  .a-sep--reverse .a-sep__track {
    animation-name: sep-marquee-rev;
    animation-duration: 30s;
  }
  @keyframes sep-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes sep-marquee-rev {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sep__track { animation: none; }
  }
</style>
