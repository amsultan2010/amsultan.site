---
interface Props {
  phrases?: string[];
  class?: string;
}
const {
  phrases = ['tutoring', 'f1', 'quant', 'lab', 'riyadh'],
  class: className = '',
} = Astro.props;

const strip = Array.from({ length: 28 }, (_, i) => phrases[i % phrases.length]).join('  ·  ');
---

<div class={`a-sep js-sep ${className}`} aria-hidden="true">
  <div class="a-sep__track vf-mono">{strip}  ·  {strip}</div>
</div>

<style>
  .a-sep {
    overflow: hidden;
    border: none;
    background: transparent;
    color: var(--vf-mark);
    padding: 1.35rem 0;
    user-select: none;
    transform-origin: center;
    border-block: 1px solid color-mix(in srgb, var(--vf-ink) 18%, transparent);
  }
  .a-sep__track {
    white-space: nowrap;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    animation: sep-marquee 28s linear infinite;
    width: max-content;
  }
  @keyframes sep-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sep__track { animation: none; }
  }
</style>
