---
interface Props {
  phrases?: string[];
  class?: string;
  reverse?: boolean;
}
const {
  phrases = ['tutoring', 'f1', 'quant', 'riyadh'],
  class: className = '',
  reverse = false,
} = Astro.props;

const strip = Array.from({ length: 28 }, (_, i) => phrases[i % phrases.length]).join('  ·  ');
---

<div class={`a-sep js-sep ${reverse ? 'a-sep--reverse' : ''} ${className}`} aria-hidden="true">
  <div class="a-sep__track vf-mono">{strip}  ·  {strip}</div>
</div>

<style>
  .a-sep {
    overflow: hidden;
    border: none;
    background: transparent;
    color: color-mix(in srgb, var(--vf-mark) 75%, var(--vf-ink));
    padding: 1.15rem 0;
    user-select: none;
    transform-origin: center;
    border-block: 1px solid var(--vf-line);
  }
  .a-sep__track {
    white-space: nowrap;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    animation: sep-marquee 30s linear infinite;
    width: max-content;
  }
  .a-sep--reverse .a-sep__track {
    animation-name: sep-marquee-rev;
    animation-duration: 34s;
  }
  @keyframes sep-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes sep-marquee-rev {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sep__track { animation: none; }
  }
</style>
