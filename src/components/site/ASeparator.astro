---
interface Props {
  phrases?: string[];
  class?: string;
  reverse?: boolean;
}
const {
  phrases = ['tutoring', 'f1', 'quant', 'riyadh'],
  class: className = '',
  reverse = false,
} = Astro.props;

const strip = Array.from({ length: 24 }, (_, i) => phrases[i % phrases.length]).join('  ·  ');
---

<div class={`a-sep js-sep ${reverse ? 'a-sep--reverse' : ''} ${className}`} aria-hidden="true">
  <div class="a-sep__track vf-mono">{strip}  ·  {strip}</div>
</div>

<style>
  .a-sep {
    overflow: hidden;
    color: var(--vf-mark);
    padding: 1rem 0;
    user-select: none;
    border-block: 1px solid var(--vf-line);
  }
  .a-sep__track {
    white-space: nowrap;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    animation: sep-marquee 36s linear infinite;
    width: max-content;
  }
  .a-sep--reverse .a-sep__track {
    animation-direction: reverse;
  }
  @keyframes sep-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sep__track { animation: none; }
  }
</style>
