---
import { LEADERSHIP, SKILL_GROUPS } from '../../data/proof';
---

<section id="proof" class="s-proof js-proof" aria-label="proof and leadership">
  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">leadership</p>
    <div class="vf-rule js-rule"></div>
    <ul class="s-proof__lead">
      {LEADERSHIP.map((item) => (
        <li class="s-proof__lead-item js-proof-lead">
          <div class="s-proof__lead-meta vf-mono">
            <span>{item.org}</span>
            <span>{item.period}</span>
          </div>
          <h3 class="s-proof__lead-title vf-display">{item.title}</h3>
          <p class="s-proof__lead-body vf-serif">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">stack</p>
    <div class="vf-rule js-rule"></div>
    <div class="s-proof__skills">
      {SKILL_GROUPS.map((group) => (
        <div class="s-proof__skill js-proof-skill">
          <p class="s-proof__skill-label vf-mono">{group.label}</p>
          <ul class="s-proof__skill-list vf-serif">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .s-proof {
    padding: 1vh 0 10vh;
    overflow-x: clip;
  }
  .s-proof__block {
    margin-top: 0;
    padding: 0 var(--vf-pad);
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-proof__block + .s-proof__block {
    margin-top: 3.25rem;
  }
  .s-proof__block-label {
    margin: 0 0 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-proof__lead {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .s-proof__lead-item {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--vf-line);
    min-width: 0;
  }
  .s-proof__lead-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }
  .s-proof__lead-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    overflow-wrap: anywhere;
  }
  .s-proof__lead-body {
    margin: 0.55rem 0 0;
    max-width: 40rem;
    font-size: 1.02rem;
  }
  .s-proof__skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.15rem;
  }
  .s-proof__skill {
    padding: 0.25rem 0;
    min-width: 0;
    border-top: 1px solid var(--vf-line);
  }
  .s-proof__skill-label {
    margin: 0.85rem 0 0;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-proof__skill-list {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
  }
  .s-proof__skill-list li {
    font-size: 0.95rem;
    line-height: 1.2;
  }
  @media (max-width: 560px) {
    .s-proof__skills {
      grid-template-columns: 1fr;
    }
  }
</style>
