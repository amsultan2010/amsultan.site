---
import { LEADERSHIP, SKILL_GROUPS } from '../../data/proof';
---

<section id="proof" class="s-proof js-proof" aria-label="proof and leadership">
  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">leadership</p>
    <div class="vf-rule js-rule"></div>
    <ul class="s-proof__lead">
      {LEADERSHIP.map((item) => (
        <li class="s-proof__lead-item js-proof-lead">
          <div class="s-proof__lead-meta vf-mono">
            <span>{item.org}</span>
            <span aria-hidden="true">·</span>
            <span>{item.period}</span>
          </div>
          <h3 class="s-proof__lead-title vf-display">{item.title}</h3>
          <p class="s-proof__lead-body vf-serif">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">stack</p>
    <div class="vf-rule js-rule"></div>
    <div class="s-proof__skills">
      {SKILL_GROUPS.map((group) => (
        <div class="s-proof__skill js-proof-skill">
          <p class="s-proof__skill-label vf-mono">{group.label}</p>
          <ul class="s-proof__skill-list vf-serif">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .s-proof {
    padding: 1vh 0 5vh;
    overflow-x: clip;
  }
  .s-proof__block {
    margin: 0 auto;
    padding: 0 var(--vf-pad);
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-proof__block + .s-proof__block {
    margin-top: 2.5rem;
  }
  .s-proof__block-label {
    margin: 0 0 0.55rem;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
  }
  .s-proof__lead {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    width: 100%;
  }
  .s-proof__lead-item {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--vf-line);
    min-width: 0;
  }
  .s-proof__lead-meta {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }
  .s-proof__lead-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    overflow-wrap: normal;
    word-break: normal;
    text-wrap: balance;
  }
  .s-proof__lead-body {
    margin: 0.55rem 0 0;
    max-width: 56rem;
    font-size: 1.3rem;
    line-height: 1.45;
  }
  .s-proof__skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    width: 100%;
  }
  .s-proof__skill {
    border: 1px solid var(--vf-line);
    padding: 1.1rem 1.15rem;
    min-width: 0;
    background: color-mix(in srgb, var(--vf-ink) 4%, transparent);
  }
  .s-proof__skill-label {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
  }
  .s-proof__skill-list {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .s-proof__skill-list li {
    font-size: 1.1rem;
    line-height: 1.25;
    border: 1px solid var(--vf-line);
    padding: 0.45rem 0.7rem;
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .s-proof__skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .s-proof {
      text-align: center;
    }
    .s-proof__block {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .vf-rule {
      margin: 0 auto;
    }
    .s-proof__skills {
      grid-template-columns: 1fr;
    }
    .s-proof__lead-meta,
    .s-proof__skill-list {
      justify-content: center;
    }
    .s-proof__lead-body {
      font-size: 1.2rem;
    }
    .s-proof__skill-list li {
      white-space: normal;
    }
  }
</style>
