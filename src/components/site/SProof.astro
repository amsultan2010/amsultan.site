---
import { LEADERSHIP, SKILL_GROUPS } from '../../data/proof';
---

<section id="proof" class="s-proof js-proof" aria-label="proof and leadership">
  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">leadership</p>
    <div class="vf-rule js-rule"></div>
    <ul class="s-proof__lead">
      {LEADERSHIP.map((item) => (
        <li class="s-proof__lead-item js-proof-lead">
          <div class="s-proof__lead-meta vf-mono">
            <span>{item.org}</span>
            <span>{item.period}</span>
          </div>
          <h3 class="s-proof__lead-title vf-display">{item.title}</h3>
          <p class="s-proof__lead-body vf-serif">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="s-proof__block">
    <p class="vf-mono s-proof__block-label">stack</p>
    <div class="vf-rule js-rule"></div>
    <div class="s-proof__skills">
      {SKILL_GROUPS.map((group) => (
        <div class="s-proof__skill js-proof-skill">
          <p class="s-proof__skill-label vf-mono">{group.label}</p>
          <ul class="s-proof__skill-list vf-serif">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .s-proof {
    padding: 1vh 0 6vh;
    overflow-x: clip;
  }
  .s-proof__block {
    margin-top: 0;
    padding: 0 var(--vf-pad);
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-proof__block + .s-proof__block {
    margin-top: 2.25rem;
  }
  .s-proof__block-label {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--vf-mark);
  }
  .s-proof__lead {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .s-proof__lead-item {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--vf-line);
    min-width: 0;
  }
  .s-proof__lead-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
  .s-proof__lead-title {
    margin: 0.4rem 0 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    overflow-wrap: anywhere;
  }
  .s-proof__lead-body {
    margin: 0.45rem 0 0;
    max-width: 42rem;
    font-size: 1.15rem;
    line-height: 1.45;
  }
  .s-proof__skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 0.9rem;
  }
  .s-proof__skill {
    border: 1px solid var(--vf-line);
    padding: 0.9rem 1rem;
    min-width: 0;
    background: color-mix(in srgb, var(--vf-ink) 4%, transparent);
  }
  .s-proof__skill-label {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--vf-mark);
  }
  .s-proof__skill-list {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .s-proof__skill-list li {
    font-size: 1.05rem;
    line-height: 1.25;
    border: 1px solid var(--vf-line);
    padding: 0.4rem 0.6rem;
  }
  @media (max-width: 560px) {
    .s-proof__skills {
      grid-template-columns: 1fr;
    }
  }
</style>
