---
const talk = 'talk';
---

<section id="contact" class="s-contact" aria-label="contact">
  <div class="s-contact__inner">
    <a
      href="mailto:abdullahmsultan1@gmail.com"
      class="s-contact__go js-contact-go vf-display"
    >
      <span class="s-contact__go-label js-contact-go-label">go</span>
      <span class="s-contact__reveal js-contact-reveal" aria-hidden="true">
        {[...talk].map((ch) => (
          <span class="js-contact-letter">{ch}</span>
        ))}
      </span>
    </a>
    <h2 class="s-contact__title vf-display">want to talk?</h2>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <p class="s-contact__sub vf-serif">
      founders, recruiters, curious builders. email me. coffee chats welcome.
    </p>
    <div class="s-contact__links vf-mono">
      <a href="https://github.com/amsultan2010" target="_blank" rel="noopener noreferrer" class="js-scramble">github</a>
      <a href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/" target="_blank" rel="noopener noreferrer" class="js-scramble">linkedin</a>
      <a href="/lab" class="js-scramble">visit the lab</a>
      <a href="/resume.docx" class="js-scramble">resume</a>
    </div>
  </div>
</section>

<style>
  .s-contact {
    padding: 2vh 0 12vh;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow-x: clip;
  }
  .s-contact__inner {
    width: 100%;
    padding: 3rem var(--vf-pad) 5rem;
    text-align: center;
    position: relative;
    min-width: 0;
  }
  .s-contact__inner::before {
    content: '';
    position: absolute;
    inset: 8% 8%;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--vf-mark) 20%, transparent), transparent 70%);
    pointer-events: none;
  }
  .s-contact__go {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    font-size: clamp(4.5rem, 18vw, 14rem);
    line-height: 0.82;
    color: var(--vf-ink);
    perspective: 900px;
    transform-style: preserve-3d;
    will-change: transform;
    max-width: 100%;
  }
  .s-contact__go:hover .s-contact__go-label,
  .s-contact__go:focus .s-contact__go-label {
    color: var(--vf-mark);
  }
  .s-contact__reveal {
    display: flex;
    gap: 0.02em;
    font-size: 0.26em;
    letter-spacing: 0.14em;
    margin-top: 0.1em;
    min-height: 1.2em;
  }
  .js-contact-letter {
    display: inline-block;
  }
  .s-contact__title {
    position: relative;
    margin: 1.1rem 0 0;
    font-size: clamp(1.5rem, 4.5vw, 2.6rem);
    overflow-wrap: anywhere;
  }
  .s-contact__email {
    position: relative;
    margin: 1.1rem 0 0;
    font-size: clamp(0.62rem, 2.2vw, 0.75rem);
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
  }
  .s-contact__email a {
    text-decoration: none;
    border-bottom: 1px solid var(--vf-ink);
  }
  .s-contact__email a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-contact__sub {
    position: relative;
    margin: 1rem auto 0;
    max-width: 28rem;
    font-size: clamp(1.05rem, 2.4vw, 1.15rem);
    padding: 0 0.5rem;
  }
  .s-contact__links {
    position: relative;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }
  .s-contact__links a {
    text-decoration: none;
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
  }
  .s-contact__links a:hover {
    color: var(--vf-mark);
  }
</style>
