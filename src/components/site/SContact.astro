---
const talk = 'talk';
---

<section id="contact" class="s-contact" aria-label="contact">
  <div class="s-contact__inner">
    <a
      href="mailto:abdullahmsultan1@gmail.com"
      class="s-contact__go js-contact-go vf-display"
    >
      <span class="s-contact__go-label js-contact-go-label">go</span>
      <span class="s-contact__reveal js-contact-reveal" aria-hidden="true">
        {[...talk].map((ch) => (
          <span class="js-contact-letter">{ch}</span>
        ))}
      </span>
    </a>
    <h2 class="s-contact__title vf-display">want to talk?</h2>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <p class="s-contact__sub vf-serif">
      email me. coffee chats welcome.
    </p>
    <div class="s-contact__links vf-mono">
      <a href="https://github.com/amsultan2010" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="/resume.docx">resume</a>
    </div>
  </div>
</section>

<style>
  .s-contact {
    padding: 4vh 0 14vh;
    min-height: 75vh;
    display: flex;
    align-items: center;
    overflow-x: clip;
  }
  .s-contact__inner {
    width: 100%;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    padding: 2rem var(--vf-pad);
    text-align: left;
  }
  .s-contact__go {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    font-size: clamp(4.5rem, 16vw, 11rem);
    line-height: 0.82;
    color: var(--vf-ink);
    transition: color 0.35s var(--vf-ease);
  }
  .s-contact__go:hover .s-contact__go-label,
  .s-contact__go:focus .s-contact__go-label {
    color: var(--vf-mark);
  }
  .s-contact__reveal {
    display: flex;
    gap: 0.02em;
    font-size: 0.24em;
    letter-spacing: 0.14em;
    margin-top: 0.1em;
    min-height: 1.2em;
  }
  .js-contact-letter {
    display: inline-block;
  }
  .s-contact__title {
    margin: 1.25rem 0 0;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
  }
  .s-contact__email {
    margin: 1rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    overflow-wrap: anywhere;
  }
  .s-contact__email a {
    text-decoration: none;
    border-bottom: 1px solid var(--vf-ink);
    transition: color 0.25s var(--vf-ease), border-color 0.25s var(--vf-ease);
  }
  .s-contact__email a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-contact__sub {
    margin: 1rem 0 0;
    max-width: 26rem;
    font-size: 1.15rem;
  }
  .s-contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }
  .s-contact__links a {
    text-decoration: none;
    min-height: 2.4rem;
    display: inline-flex;
    align-items: center;
    transition: color 0.25s var(--vf-ease);
  }
  .s-contact__links a:hover {
    color: var(--vf-mark);
  }
</style>
