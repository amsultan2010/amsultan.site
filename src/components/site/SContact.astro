---
const talkTop = ['l', 'e', 't', "'", 's'];
const talkBot = ['t', 'a', 'l', 'k'];
---

<section id="contact" class="s-contact" aria-label="contact">
  <div class="s-contact__inner js-contact-inner">
    <div class="s-contact__hover js-contact-hover">
      <a
        href="mailto:abdullahmsultan1@gmail.com"
        class="s-contact__go js-contact-go vf-display"
      >
        <span class="s-contact__go-label js-contact-go-label">go</span>
      </a>

      <div class="s-contact__reveal-panel js-contact-panel" aria-hidden="true">
        <div class="s-contact__cta-line s-contact__cta-line--top">
          {talkTop.map((ch) => (
            <span class="s-contact__cta-char">
              <span class="s-contact__cta-slice">{ch}</span>
              <span class="s-contact__cta-slice" aria-hidden="true">{ch}</span>
            </span>
          ))}
        </div>
        <div class="s-contact__cta-line s-contact__cta-line--bot">
          {talkBot.map((ch) => (
            <span class="s-contact__cta-char">
              <span class="s-contact__cta-slice">{ch}</span>
              <span class="s-contact__cta-slice" aria-hidden="true">{ch}</span>
            </span>
          ))}
        </div>
        <p class="s-contact__panel-email vf-mono">abdullahmsultan1@gmail.com</p>
        <div class="s-contact__stars" aria-hidden="true">
          <span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
      </div>
    </div>

    <h2 class="s-contact__title vf-display">want to talk?</h2>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <p class="s-contact__sub vf-serif">
      email me. coffee chats welcome.
    </p>
    <div class="s-contact__links vf-mono">
      <a href="https://github.com/amsultan2010" target="_blank" rel="noopener noreferrer" class="js-scramble">github</a>
      <a href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/" target="_blank" rel="noopener noreferrer" class="js-scramble">linkedin</a>
      <a href="/resume.docx" class="js-scramble">resume</a>
    </div>
  </div>
</section>

<style>
  .s-contact {
    padding: 1vh 0 7vh;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: clip;
    text-align: center;
  }
  .s-contact__inner {
    width: 100%;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    margin: 0 auto;
    padding: 2rem var(--vf-pad) 3rem;
    text-align: center;
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s-contact__hover {
    position: relative;
    display: grid;
    place-items: center;
    width: min(22rem, 70vw);
    height: min(22rem, 70vw);
    margin: 0 auto 0.5rem;
  }
  .s-contact__go {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border: 1px solid var(--vf-ink);
    border-radius: 50%;
    font-size: clamp(4.5rem, 16vw, 9rem);
    line-height: 0.85;
    color: var(--vf-ink);
    transition: color 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s;
    will-change: transform;
  }
  .s-contact__go-label {
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s;
  }
  .s-contact__hover.is-active .s-contact__go {
    border-color: transparent;
    color: var(--vf-field);
    transform: scale(0.92);
    transition: color 0.35s, border-color 0.35s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .s-contact__hover.is-active .s-contact__go-label {
    color: var(--vf-field);
    transform: scale(0.7);
  }
  .s-contact__reveal-panel {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    border-radius: 50%;
    background: var(--vf-mark);
    color: var(--vf-field);
    clip-path: circle(0% at 50% 50%);
    transition: clip-path 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .s-contact__hover.is-active .s-contact__reveal-panel {
    clip-path: circle(72% at 50% 50%);
    pointer-events: auto;
  }
  .s-contact__cta-line {
    display: flex;
    gap: 0.04em;
    font-family: var(--vf-font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 7vw, 3.2rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .s-contact__cta-char {
    display: inline-grid;
    overflow: hidden;
    will-change: transform, opacity;
  }
  .s-contact__cta-slice {
    display: block;
  }
  .s-contact__cta-slice:nth-child(2) {
    opacity: 0.35;
  }
  .s-contact__hover.is-active .s-contact__cta-slice:nth-child(2) {
    animation: contact-ghost 1.4s ease-in-out infinite;
  }
  @keyframes contact-ghost {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50% { transform: translateY(0.08em); opacity: 0.55; }
  }
  .s-contact__panel-email {
    margin: 0.85rem 0 0;
    font-size: 1rem;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s 0.35s, transform 0.4s 0.35s;
  }
  .s-contact__hover.is-active .s-contact__panel-email {
    opacity: 0.9;
    transform: translateY(0);
  }
  .s-contact__stars {
    position: absolute;
    inset: 12% 12%;
    pointer-events: none;
  }
  .s-contact__stars span {
    position: absolute;
    font-size: 1.15rem;
    opacity: 0.7;
    animation: contact-star 8s ease-in-out infinite;
  }
  .s-contact__stars span:nth-child(1) { top: 0; left: 50%; }
  .s-contact__stars span:nth-child(2) { top: 50%; right: 0; animation-delay: -2s; }
  .s-contact__stars span:nth-child(3) { bottom: 0; left: 50%; animation-delay: -4s; }
  .s-contact__stars span:nth-child(4) { top: 50%; left: 0; animation-delay: -6s; }
  @keyframes contact-star {
    0%, 100% { transform: scale(0.85) rotate(0deg); opacity: 0.45; }
    50% { transform: scale(1.15) rotate(40deg); opacity: 0.95; }
  }
  .s-contact__title {
    position: relative;
    margin: 1rem 0 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    overflow-wrap: normal;
    word-break: normal;
  }
  .s-contact__email {
    position: relative;
    margin: 1rem 0 0;
    font-size: clamp(1.2rem, 2.6vw, 1.45rem);
    letter-spacing: 0.04em;
    overflow-wrap: break-word;
    word-break: normal;
  }
  .s-contact__email a {
    text-decoration: none;
    border-bottom: 1px solid var(--vf-ink);
    display: inline-flex;
    align-items: center;
    min-height: var(--vf-tap);
    padding: 0.25rem 0;
  }
  .s-contact__email a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-contact__sub {
    position: relative;
    margin: 0.9rem auto 0;
    max-width: 40rem;
    font-size: clamp(1.45rem, 2.8vw, 1.7rem);
    padding: 0 0.5rem;
  }
  .s-contact__links {
    position: relative;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
  }
  .s-contact__links a {
    text-decoration: none;
    min-height: var(--vf-tap);
    min-width: 5.5rem;
    padding: 0.45rem 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--vf-ink) 28%, transparent);
  }
  .s-contact__links a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }

  @media (max-width: 720px) {
    .s-contact {
      min-height: auto;
      padding: 1vh 0 5vh;
    }
    .s-contact__hover {
      width: min(16.5rem, 78vw);
      height: min(16.5rem, 78vw);
    }
    .s-contact__go {
      font-size: clamp(3.6rem, 22vw, 5.5rem);
    }
    .s-contact__cta-line {
      font-size: clamp(1.4rem, 8vw, 2.2rem);
    }
    .s-contact__title {
      font-size: 1.9rem;
    }
    .s-contact__links {
      width: 100%;
      max-width: 20rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .s-contact__links a {
      width: 100%;
      min-height: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .s-contact__reveal-panel,
    .s-contact__go,
    .s-contact__stars span {
      transition: none;
      animation: none;
    }
  }
</style>
