<section id="contact" class="s-contact" aria-label="Contact">
  <div class="vf-band">contact</div>
  <div class="s-contact__inner">
    <p class="s-contact__kicker vf-mono">founders · recruiters · curious builders</p>
    <h2 class="s-contact__title vf-display js-contact-title js-warp">Let’s talk</h2>
    <p class="s-contact__sub vf-serif">
      Coffee chats welcome. Products, education, quant systems, or agent workflows. Say what you’re
      building.
    </p>
    <a
      href="mailto:abdullahmsultan1@gmail.com"
      class="s-contact__go js-contact-go vf-mono"
    >
      email me →
    </a>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <div class="s-contact__links vf-mono">
      <a href="https://github.com/amsultan2010" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="/resume.docx">resume</a>
    </div>
  </div>
</section>

<style>
  .s-contact {
    padding: 2vh 0 8vh;
  }
  .s-contact__inner {
    padding: 3rem var(--vf-pad) 5rem;
    max-width: 44rem;
    position: relative;
  }
  .s-contact__inner::before {
    content: '';
    position: absolute;
    inset: 5% 0 auto;
    height: 55%;
    background: radial-gradient(ellipse at left, color-mix(in srgb, var(--vf-mark) 22%, transparent), transparent 70%);
    pointer-events: none;
  }
  .s-contact__kicker {
    position: relative;
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-contact__title {
    position: relative;
    margin: 0.75rem 0 0;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
  }
  .s-contact__sub {
    position: relative;
    margin: 1.1rem 0 0;
    font-size: 1.2rem;
    max-width: 34rem;
  }
  .s-contact__go {
    position: relative;
    display: inline-flex;
    margin-top: 1.75rem;
    padding: 0.95rem 1.35rem;
    border: 1px solid var(--vf-ink);
    background: var(--vf-ink);
    color: var(--vf-field);
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    transition: background 0.2s, color 0.2s;
  }
  .s-contact__go:hover,
  .s-contact__go:focus {
    background: transparent;
    color: var(--vf-ink);
  }
  .s-contact__email {
    position: relative;
    margin: 1.25rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .s-contact__email a {
    text-decoration: none;
    border-bottom: 1px solid var(--vf-line);
  }
  .s-contact__email a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-contact__links {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }
  .s-contact__links a {
    text-decoration: none;
  }
  .s-contact__links a:hover {
    color: var(--vf-mark);
  }
</style>
