---
const talk = 'talk';
---

<section id="contact" class="s-contact" aria-label="contact">
  <div class="s-contact__inner">
    <p class="s-contact__kicker vf-mono">contact</p>
    <a
      href="mailto:abdullahmsultan1@gmail.com"
      class="s-contact__go js-contact-go vf-display"
    >
      <span class="s-contact__go-label js-contact-go-label">go</span>
      <span class="s-contact__reveal js-contact-reveal" aria-hidden="true">
        {[...talk].map((ch) => (
          <span class="js-contact-letter">{ch}</span>
        ))}
      </span>
    </a>
    <h2 class="s-contact__title vf-display">want to talk?</h2>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <p class="s-contact__sub vf-serif">
      founders, recruiters, curious builders. email me. coffee chats welcome.
    </p>
    <div class="s-contact__links vf-mono">
      <a href="https://github.com/amsultan2010" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="/lab">visit the lab</a>
      <a href="/resume.docx">resume</a>
    </div>
  </div>
</section>

<style>
  .s-contact {
    padding: 4vh 0 12vh;
    min-height: 85vh;
    display: flex;
    align-items: center;
  }
  .s-contact__inner {
    width: 100%;
    padding: 4rem var(--vf-pad) 6rem;
    text-align: center;
    position: relative;
  }
  .s-contact__inner::before {
    content: '';
    position: absolute;
    inset: 8% 10%;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--vf-mark) 20%, transparent), transparent 70%);
    pointer-events: none;
  }
  .s-contact__kicker {
    position: relative;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--vf-mark);
  }
  .s-contact__go {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.75rem;
    text-decoration: none;
    font-size: clamp(5.5rem, 22vw, 15rem);
    line-height: 0.82;
    color: var(--vf-ink);
    perspective: 900px;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .s-contact__go:hover .s-contact__go-label,
  .s-contact__go:focus .s-contact__go-label {
    color: var(--vf-mark);
  }
  .s-contact__reveal {
    display: flex;
    gap: 0.02em;
    font-size: 0.26em;
    letter-spacing: 0.14em;
    margin-top: 0.1em;
    min-height: 1.2em;
  }
  .js-contact-letter {
    display: inline-block;
  }
  .s-contact__title {
    position: relative;
    margin: 1.25rem 0 0;
    font-size: clamp(1.8rem, 5vw, 3rem);
  }
  .s-contact__email {
    position: relative;
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .s-contact__email a {
    text-decoration: none;
    border-bottom: 1px solid var(--vf-ink);
  }
  .s-contact__email a:hover {
    color: var(--vf-mark);
    border-color: var(--vf-mark);
  }
  .s-contact__sub {
    position: relative;
    margin: 1rem auto 0;
    max-width: 28rem;
    font-size: 1.15rem;
  }
  .s-contact__links {
    position: relative;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }
  .s-contact__links a {
    text-decoration: none;
  }
  .s-contact__links a:hover {
    color: var(--vf-mark);
  }
</style>
