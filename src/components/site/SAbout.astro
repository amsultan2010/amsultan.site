---
import { EDUCATION } from '../../data/education';
---

<section id="about" class="s-about js-about" aria-label="about">
  <div class="s-about__grid">
    <div class="s-about__copy js-about-copy">
      <h2 class="s-about__title vf-display">building in public from riyadh</h2>
      <p class="s-about__body vf-serif">
        i care about products that teach, tools that automate the boring parts, and systems that
        prove the math. currently a student. shipping tutoringbyabdullah, an f1 media experiment,
        and a small quant suite as technical proof.
      </p>
      <p class="s-about__body vf-serif">
        also founding x-combinator, ais-r’s first student-run startup incubator. looking for coffee
        chats with builders this summer.
      </p>
      <p class="s-about__resume">
        <a href="/resume.docx" class="vf-mono">download resume →</a>
      </p>
    </div>

    <aside class="s-about__aside js-about-aside">
      <p class="s-about__aside-label vf-mono">currently</p>
      <ul class="s-about__now">
        <li>ais-r · 10th grade</li>
        <li>shipping tutoring + quantpy</li>
        <li>writing the downforce blog</li>
        <li>founding x-combinator</li>
      </ul>
    </aside>
  </div>

  <div class="vf-band" style="margin-top: 3rem;">education</div>
  <ul class="s-about__creds">
    {EDUCATION.map((entry) => (
      <li class="s-about__cred js-about-cred">
        <div class="s-about__cred-top">
          <span class="s-about__cred-years vf-mono">{entry.years}</span>
          <img class="s-about__cred-logo" src={entry.logo} alt="" width="36" height="36" loading="lazy" />
        </div>
        <h3 class="s-about__cred-school vf-display">{entry.school}</h3>
        <p class="s-about__cred-loc vf-mono">{entry.location}</p>
        <p class="s-about__cred-focus vf-serif">{entry.focus}</p>
        <ul class="s-about__cred-list vf-serif">
          {entry.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .s-about {
    padding: 2vh 0 10vh;
  }
  .s-about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.7fr);
    gap: 2.5rem;
    padding: 1.5rem var(--vf-pad) 0;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-about__title {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.8rem);
  }
  .s-about__body {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    max-width: 38rem;
  }
  .s-about__resume {
    margin: 1.75rem 0 0;
  }
  .s-about__resume a {
    text-decoration: none;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
    border-bottom: 1px solid var(--vf-mark);
    color: var(--vf-mark);
  }
  .s-about__aside {
    border: 1px solid var(--vf-line);
    padding: 1.25rem;
    align-self: start;
    background: color-mix(in srgb, var(--vf-ink) 6%, transparent);
  }
  .s-about__aside-label {
    margin: 0 0 0.85rem;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--vf-mark);
  }
  .s-about__now {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    font-family: var(--vf-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  .s-about__creds {
    list-style: none;
    margin: 0;
    padding: 1rem var(--vf-pad) 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-about__cred {
    border-top: 1px solid var(--vf-line);
    padding: 1.25rem 0 0.5rem;
  }
  .s-about__cred-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .s-about__cred-years {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }
  .s-about__cred-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    filter: grayscale(0.2);
  }
  .s-about__cred-school {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.15;
  }
  .s-about__cred-loc {
    margin: 0.4rem 0 0;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .s-about__cred-focus {
    margin: 0.75rem 0 0;
    font-size: 0.98rem;
    opacity: 0.92;
  }
  .s-about__cred-list {
    margin: 0.85rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    display: grid;
    gap: 0.35rem;
  }
  @media (max-width: 860px) {
    .s-about__grid,
    .s-about__creds {
      grid-template-columns: 1fr;
    }
  }
</style>
