---
import { EDUCATION } from '../../data/education';
---

<section id="about" class="s-about js-about" aria-label="about">
  <div class="s-about__grid">
    <div class="s-about__copy js-about-copy">
      <h2 class="s-about__title vf-display js-reveal-lines">building from riyadh</h2>
      <p class="s-about__body vf-serif">
        student at ais-r. shipping tutoringbyabdullah, the downforce blog, and a small quant suite.
        founding x-combinator, a student-run startup incubator.
      </p>
      <p class="s-about__resume">
        <a href="/resume.docx" class="vf-mono js-magnetic js-scramble">download resume →</a>
      </p>
    </div>

    <aside class="s-about__aside js-about-aside">
      <p class="s-about__aside-label vf-mono">currently</p>
      <ul class="s-about__now">
        <li>ais-r · 10th grade</li>
        <li>shipping tutoring + quantpy</li>
        <li>writing the downforce blog</li>
        <li>founding x-combinator</li>
      </ul>
    </aside>
  </div>

  <div class="s-about__edu-head">
    <p class="vf-mono s-about__edu-label">education</p>
    <div class="vf-rule js-rule"></div>
  </div>

  <ol class="s-about__timeline">
    {EDUCATION.map((entry, i) => (
      <li class="s-about__cred js-about-cred">
        <div class="s-about__cred-rail" aria-hidden="true">
          <span class="s-about__cred-dot"></span>
          {i < EDUCATION.length - 1 && <span class="s-about__cred-line"></span>}
        </div>
        <div class="s-about__cred-body">
          <div class="s-about__cred-top">
            <span class="s-about__cred-years vf-mono">{entry.years}</span>
            <img class="s-about__cred-logo" src={entry.logo} alt="" width="36" height="36" loading="lazy" />
          </div>
          <h3 class="s-about__cred-school vf-display">{entry.short ?? entry.school}</h3>
          <p class="s-about__cred-loc vf-mono">{entry.location}</p>
          <p class="s-about__cred-focus vf-serif">{entry.focus}</p>
          <ul class="s-about__cred-list vf-serif">
            {entry.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .s-about {
    padding: 1vh 0 5vh;
    overflow-x: clip;
    text-align: center;
  }
  .s-about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 0 var(--vf-pad);
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    margin: 0 auto;
    justify-items: center;
  }
  .s-about__copy {
    max-width: 40rem;
  }
  .s-about__title {
    margin: 0 auto;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    max-width: 12ch;
    overflow-wrap: anywhere;
    word-break: break-word;
    hyphens: auto;
    text-align: center;
  }
  .s-about__body {
    margin: 1rem auto 0;
    font-size: clamp(1.3rem, 2.6vw, 1.55rem);
    line-height: 1.45;
    max-width: 36rem;
    text-align: center;
  }
  .s-about__resume {
    margin: 1.25rem 0 0;
  }
  .s-about__resume a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--vf-tap);
    text-decoration: none;
    letter-spacing: 0.06em;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--vf-mark);
    color: var(--vf-mark);
    padding: 0.35rem 0.15rem;
  }
  .s-about__aside {
    border: 1px solid var(--vf-line);
    padding: 1.15rem 1.35rem;
    background: color-mix(in srgb, var(--vf-ink) 6%, transparent);
    width: 100%;
    max-width: 28rem;
  }
  .s-about__aside-label {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
  }
  .s-about__now {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-family: var(--vf-font-mono);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  .s-about__edu-head {
    margin: 2.5rem auto 0;
    padding: 0 var(--vf-pad);
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }
  .s-about__edu-label {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--vf-mark);
  }
  .s-about__timeline {
    list-style: none;
    margin: 1.25rem auto 0;
    padding: 0 var(--vf-pad);
    display: grid;
    gap: 0;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
  }
  .s-about__cred {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.85rem;
    padding: 0 0 1.35rem;
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
    width: 100%;
  }
  .s-about__cred-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s-about__cred-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--vf-mark);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }
  .s-about__cred-line {
    flex: 1;
    width: 1px;
    margin-top: 0.35rem;
    background: var(--vf-line);
    transform-origin: top center;
  }
  .s-about__cred-body {
    min-width: 0;
    border-top: 1px solid var(--vf-line);
    padding-top: 0.85rem;
  }
  .s-about__cred-top {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .s-about__cred-years {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }
  .s-about__cred-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
    filter: grayscale(0.2);
  }
  .s-about__cred-school {
    margin: 0;
    font-size: clamp(1.65rem, 3.6vw, 2.35rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .s-about__cred-loc {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }
  .s-about__cred-focus {
    margin: 0.65rem auto 0;
    font-size: 1.25rem;
    opacity: 0.95;
    max-width: 36rem;
  }
  .s-about__cred-list {
    margin: 0.75rem auto 0;
    padding: 0;
    list-style: none;
    font-size: 1.15rem;
    display: grid;
    gap: 0.4rem;
    max-width: 36rem;
  }
  .s-about__cred-list li::before {
    content: '· ';
    color: var(--vf-mark);
  }

  @media (max-width: 720px) {
    .s-about__cred {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .s-about__cred-rail {
      display: none;
    }
    .s-about__title {
      font-size: clamp(2.2rem, 11vw, 3rem);
    }
    .s-about__body {
      font-size: 1.25rem;
    }
    .s-about__resume a {
      font-size: 1.05rem;
      min-height: 3.1rem;
    }
    .s-about__now {
      font-size: 1.05rem;
    }
    .s-about__cred-school {
      font-size: 1.7rem;
    }
    .s-about__cred-focus,
    .s-about__cred-list {
      font-size: 1.15rem;
    }
  }
</style>
