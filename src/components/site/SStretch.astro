---
interface Props {
  word: string;
  class?: string;
}
const { word, class: className = '' } = Astro.props;
const letters = [...word.toLowerCase()];
---

<section class={`s-stretch js-stretch ${className}`} aria-hidden="true">
  <div class="s-stretch__track js-stretch-track">
    {letters.map((ch) => (
      <span class="s-stretch__letter js-stretch-letter">{ch === ' ' ? '\u00a0' : ch}</span>
    ))}
  </div>
</section>

<style>
  .s-stretch {
    min-height: 52vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 7vh 0;
    text-align: center;
  }
  .s-stretch__track {
    display: flex;
    width: 100%;
    justify-content: space-between;
    padding: 0 0.35rem;
    will-change: transform;
    perspective: 900px;
  }
  .s-stretch__letter {
    font-family: var(--vf-font-display);
    font-weight: 800;
    font-size: clamp(3.8rem, 17vw, 13rem);
    line-height: 0.72;
    letter-spacing: -0.08em;
    color: var(--vf-ink);
    flex: 1 1 0;
    text-align: center;
    transform-origin: center bottom;
    will-change: transform;
    min-width: 0;
    text-shadow: 0 0.04em 0 color-mix(in srgb, var(--vf-mark) 35%, transparent);
  }

  @media (max-width: 720px) {
    .s-stretch {
      min-height: 32vh;
      padding: 4vh 0;
    }
    .s-stretch__letter {
      font-size: clamp(3rem, 16vw, 5.5rem);
    }
  }
</style>
