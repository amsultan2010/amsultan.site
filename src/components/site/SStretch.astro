---
interface Props {
  word: string;
  class?: string;
}
const { word, class: className = '' } = Astro.props;
const letters = [...word.toUpperCase()];
---

<section class={`s-stretch js-stretch ${className}`} aria-hidden="true">
  <div class="s-stretch__track js-stretch-track">
    {letters.map((ch) => (
      <span class="s-stretch__letter js-stretch-letter">{ch}</span>
    ))}
  </div>
</section>

<style>
  .s-stretch {
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 8vh 0;
  }
  .s-stretch__track {
    display: flex;
    width: 100%;
    justify-content: space-between;
    padding: 0 0.5rem;
    will-change: transform;
  }
  .s-stretch__letter {
    font-family: var(--vf-font-display);
    font-weight: 800;
    font-size: clamp(4rem, 18vw, 14rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--vf-ink);
    flex: 1 1 0;
    text-align: center;
    transform-origin: center;
  }
</style>
