<style>
  .site-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.75rem var(--vf-pad) 2.25rem;
    border-top: 1px solid color-mix(in srgb, var(--vf-ink) 18%, transparent);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    opacity: 0.85;
    text-align: left;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    margin: 0 auto;
    width: 100%;
  }
  .site-foot p { margin: 0; }
  .site-foot__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 0.85rem;
  }
  .site-foot__links a {
    text-decoration: none;
    min-height: var(--vf-tap);
    min-width: 4.5rem;
    padding: 0.4rem 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .site-foot__links a:hover {
    color: var(--vf-mark);
  }

  @media (max-width: 720px) {
    .site-foot {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
      font-size: 1.05rem;
    }
    .site-foot__links {
      width: 100%;
      max-width: 22rem;
      justify-content: center;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem;
    }
    .site-foot__links a {
      width: 100%;
      min-height: 3.1rem;
      border: 1px solid color-mix(in srgb, var(--vf-ink) 22%, transparent);
    }
  }
</style>
