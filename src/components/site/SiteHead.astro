---
---

<header class="site-head">
  <a href="/#top" class="site-head__brand vf-mono js-magnetic">abdullah sultan</a>
  <nav class="site-head__nav vf-mono" aria-label="primary">
    <a href="/#about" data-section="about" class="js-nav-link js-scramble">about</a>
    <a href="/#work" data-section="work" class="js-nav-link js-scramble">work</a>
    <a href="/#proof" data-section="proof" class="js-nav-link js-scramble">proof</a>
    <a href="/#contact" data-section="contact" class="js-nav-link js-scramble">contact</a>
  </nav>
  <button type="button" class="site-head__contrast js-contrast vf-mono" aria-label="toggle contrast">
    contrast
  </button>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 0.85rem var(--vf-pad);
    position: sticky;
    top: 0.65rem;
    z-index: 20;
    margin: 0 var(--vf-pad);
    width: calc(100% - 2 * var(--vf-pad));
    border: 1px solid color-mix(in srgb, var(--vf-ink) 10%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--vf-field) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--vf-ink) 6%, transparent);
  }
  .site-head__brand {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--vf-ink);
    padding: 0.4rem 0.35rem;
    display: inline-block;
  }
  .site-head__brand:hover {
    color: var(--vf-mark);
  }
  .site-head__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--vf-ink);
    opacity: 0.7;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    transition: opacity 0.2s, color 0.2s, background 0.2s;
  }
  .site-head__nav a:hover {
    opacity: 1;
    color: var(--vf-mark);
  }
  .site-head__nav a.is-active {
    opacity: 1;
    color: var(--vf-field);
    background: var(--vf-ink);
  }
  .site-head__contrast {
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    background: transparent;
    border: 1px solid var(--vf-ink);
    color: var(--vf-ink);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    min-height: 2.4rem;
    border-radius: 999px;
  }
  .site-head__contrast:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: #fffaf5;
    box-shadow: 0 0 16px var(--vf-glow);
  }
  @media (max-width: 820px) {
    .site-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      border-radius: 1.25rem;
      top: 0.4rem;
    }
    .site-head__nav {
      grid-column: 1 / -1;
      order: 3;
      padding-top: 0.1rem;
    }
  }
</style>
