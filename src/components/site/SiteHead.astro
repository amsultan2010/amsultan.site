---
---

<header class="site-head">
  <a href="/#top" class="site-head__brand vf-mono">abdullah sultan</a>
  <nav class="site-head__nav vf-mono" aria-label="primary">
    <a href="/#about">about</a>
    <a href="/#work">work</a>
    <a href="/#proof">proof</a>
    <a href="/#contact">contact</a>
  </nav>
  <button type="button" class="site-head__contrast js-contrast vf-mono" aria-label="toggle contrast">
    contrast
  </button>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem var(--vf-pad);
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--vf-field) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-head__brand {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--vf-ink);
  }
  .site-head__brand:hover {
    color: var(--vf-mark);
  }
  .site-head__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--vf-ink);
    opacity: 0.8;
  }
  .site-head__nav a:hover {
    opacity: 1;
    color: var(--vf-mark);
  }
  .site-head__contrast {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    background: transparent;
    border: 1px solid var(--vf-ink);
    color: var(--vf-ink);
    padding: 0.35rem 0.55rem;
    cursor: pointer;
  }
  .site-head__contrast:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: var(--vf-field);
  }
  @media (max-width: 820px) {
    .site-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
    }
    .site-head__nav {
      grid-column: 1 / -1;
      order: 3;
      padding-top: 0.2rem;
    }
  }
</style>
