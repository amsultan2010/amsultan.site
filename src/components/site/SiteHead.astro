---
---

<header class="site-head">
  <a href="/#top" class="site-head__brand vf-mono">abdullah sultan</a>
  <nav class="site-head__nav vf-mono" aria-label="primary">
    <a href="/#about" data-section="about" class="js-nav-link">about</a>
    <a href="/#work" data-section="work" class="js-nav-link">work</a>
    <a href="/#proof" data-section="proof" class="js-nav-link">proof</a>
    <a href="/#contact" data-section="contact" class="js-nav-link">contact</a>
  </nav>
  <button type="button" class="site-head__contrast js-contrast vf-mono" aria-label="toggle contrast">
    contrast
  </button>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem var(--vf-pad);
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--vf-field) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--vf-ink) 14%, transparent);
  }
  .site-head__brand {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--vf-ink);
    padding: 0.4rem 0;
    display: inline-block;
    transition: color 0.25s var(--vf-ease);
  }
  .site-head__brand:hover {
    color: var(--vf-mark);
  }
  .site-head__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--vf-ink);
    opacity: 0.7;
    padding: 0.55rem 0.75rem;
    transition: opacity 0.25s var(--vf-ease), color 0.25s var(--vf-ease);
  }
  .site-head__nav a:hover {
    opacity: 1;
  }
  .site-head__nav a.is-active {
    opacity: 1;
    color: var(--vf-mark);
  }
  .site-head__contrast {
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    background: transparent;
    border: 1px solid var(--vf-ink);
    color: var(--vf-ink);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    min-height: 2.4rem;
    transition: background 0.25s var(--vf-ease), color 0.25s var(--vf-ease), border-color 0.25s var(--vf-ease);
  }
  .site-head__contrast:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: var(--vf-field);
  }
  @media (max-width: 820px) {
    .site-head {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
    }
    .site-head__nav {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
