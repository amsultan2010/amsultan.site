---
---

<header class="site-head">
  <a href="/#top" class="site-head__brand vf-mono js-magnetic">abdullah sultan</a>
  <nav class="site-head__nav vf-mono" aria-label="primary">
    <a href="/#about" data-section="about" class="js-nav-link js-scramble">about</a>
    <a href="/#work" data-section="work" class="js-nav-link js-scramble">work</a>
    <a href="/#proof" data-section="proof" class="js-nav-link js-scramble">proof</a>
    <a href="/#contact" data-section="contact" class="js-nav-link js-scramble">contact</a>
  </nav>
  <button type="button" class="site-head__contrast js-contrast vf-mono" aria-label="toggle contrast">
    contrast
  </button>
</header>

<style>
  .site-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.85rem var(--vf-pad) 0.95rem;
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--vf-field) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--vf-ink) 12%, transparent);
    text-align: left;
  }
  .site-head__brand {
    justify-self: start;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--vf-ink);
    min-height: var(--vf-tap);
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.5rem;
  }
  .site-head__brand:hover {
    color: var(--vf-mark);
  }
  .site-head__nav {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }
  .site-head__nav a {
    text-decoration: none;
    color: var(--vf-ink);
    opacity: 0.75;
    min-height: var(--vf-tap);
    min-width: 4.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, color 0.2s, border-color 0.2s, background 0.2s;
  }
  .site-head__nav a:hover {
    opacity: 1;
    color: var(--vf-mark);
  }
  .site-head__nav a.is-active {
    opacity: 1;
    color: var(--vf-mark);
    border-color: color-mix(in srgb, var(--vf-mark) 55%, transparent);
    background: color-mix(in srgb, var(--vf-mark) 12%, transparent);
  }
  .site-head__contrast {
    justify-self: end;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    background: transparent;
    border: 1px solid var(--vf-ink);
    color: var(--vf-ink);
    padding: 0.55rem 1rem;
    cursor: pointer;
    min-height: var(--vf-tap);
    min-width: 6.5rem;
  }
  .site-head__contrast:hover {
    background: var(--vf-mark);
    border-color: var(--vf-mark);
    color: var(--vf-field);
  }

  /* Mobile: brand + contrast on one row, nav as full-width chip row (Fitts + Hick) */
  @media (max-width: 720px) {
    .site-head {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand contrast'
        'nav nav';
      align-items: center;
      gap: 0.45rem 0.75rem;
      padding: 0.7rem var(--vf-pad) 0.8rem;
    }
    .site-head__brand {
      grid-area: brand;
      justify-self: start;
      font-size: 0.95rem;
      padding-left: 0;
    }
    .site-head__contrast {
      grid-area: contrast;
      justify-self: end;
      font-size: 0.85rem;
      min-width: 5.5rem;
      padding: 0.5rem 0.75rem;
    }
    .site-head__nav {
      grid-area: nav;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.3rem;
      font-size: 0.88rem;
    }
    .site-head__nav a {
      min-width: 0;
      width: 100%;
      padding: 0.65rem 0.2rem;
      border: 1px solid color-mix(in srgb, var(--vf-ink) 22%, transparent);
      background: color-mix(in srgb, var(--vf-ink) 5%, transparent);
    }
    .site-head__nav a.is-active {
      background: color-mix(in srgb, var(--vf-mark) 18%, transparent);
    }
  }
</style>
