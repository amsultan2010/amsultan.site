---
const talkTop = ['l', 'e', 't', "'", 's']
const talkBot = ['t', 'a', 'l', 'k']
---

<section id="contact" class="s-contact" aria-label="contact">
  <div class="s-contact__inner js-contact-inner">
    <div class="s-contact__hover js-contact-hover">
      <a href="mailto:abdullahmsultan1@gmail.com" class="s-contact__go js-contact-go vf-display">
        <span class="s-contact__go-label js-contact-go-label">go</span>
      </a>

      <div class="s-contact__reveal-panel js-contact-panel" aria-hidden="true">
        <div class="s-contact__cta-line s-contact__cta-line--top">
          {
            talkTop.map((ch) => (
              <span class="s-contact__cta-char">
                <span class="s-contact__cta-slice">{ch}</span>
                <span class="s-contact__cta-slice" aria-hidden="true">
                  {ch}
                </span>
              </span>
            ))
          }
        </div>
        <div class="s-contact__cta-line s-contact__cta-line--bot">
          {
            talkBot.map((ch) => (
              <span class="s-contact__cta-char">
                <span class="s-contact__cta-slice">{ch}</span>
                <span class="s-contact__cta-slice" aria-hidden="true">
                  {ch}
                </span>
              </span>
            ))
          }
        </div>
        <p class="s-contact__panel-email vf-mono">abdullahmsultan1@gmail.com</p>
        <div class="s-contact__stars" aria-hidden="true">
          <span>★</span>
          <span>★</span>
          <span>★</span>
          <span>★</span>
        </div>
      </div>
    </div>

    <h2 class="s-contact__title vf-display">want to talk?</h2>
    <p class="s-contact__email vf-mono">
      <a href="mailto:abdullahmsultan1@gmail.com">abdullahmsultan1@gmail.com</a>
    </p>
    <p class="s-contact__sub vf-serif">email me. coffee chats welcome.</p>
    <div class="s-contact__links vf-mono">
      <a
        href="https://github.com/amsultan2010"
        target="_blank"
        rel="noopener noreferrer"
        class="js-scramble"
      >
        github
      </a>
      <a
        href="https://www.linkedin.com/in/abdullah-sultan-4a264939a/"
        target="_blank"
        rel="noopener noreferrer"
        class="js-scramble"
      >
        linkedin
      </a>
      <a href="/resume.docx" class="js-scramble">resume</a>
    </div>
  </div>
</section>
