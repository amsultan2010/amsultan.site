---
import { AstroSeo } from '@astrolib/seo';
import Analytics from '@vercel/analytics/astro';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteFoot from '../../components/site/SiteFoot.astro';
import { PROJECTS } from '../../data/projects';
import '../../styles/voltage.css';

const total = String(PROJECTS.length).padStart(2, '0');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="abdullah sultan" />
    <AstroSeo
      title="projects | abdullah sultan"
      description="archive of shipped work: tutoring, f1 media, and quant tools."
      canonical="https://abdullahmsultan.me/projects"
      openGraph={{
        url: 'https://abdullahmsultan.me/projects',
        title: 'projects | abdullah sultan',
        description: 'archive of shipped work: tutoring, f1 media, and quant tools.',
        site_name: 'abdullah sultan',
        images: [{ url: 'https://abdullahmsultan.me/og.jpg', width: 1200, height: 630, alt: 'abdullah sultan portfolio' }],
      }}
    />
    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <meta name="theme-color" content="#ff4d1a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Unbounded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-wrapper" style="opacity: 1;">
      <SiteHead />
      <main class="archive">
        <header class="archive__head">
          <div class="archive__head-copy">
            <p class="vf-band">archive</p>
            <h1 class="archive__title vf-display">projects</h1>
            <p class="archive__lede vf-serif">tutoring, f1 media, and quant tools. {PROJECTS.length} shipped.</p>
          </div>
          <a href="/#work" class="archive__back vf-mono">← back to work</a>
        </header>

        <ul class="archive__list">
          {PROJECTS.map((project, i) => {
            const href = project.demo || project.href;
            const external = href.startsWith('http');
            const serial = `${String(i + 1).padStart(2, '0')} / ${total}`;
            return (
              <li>
                <a
                  class="archive__row"
                  href={href}
                  target={external || project.demoNewTab ? '_blank' : undefined}
                  rel={external || project.demoNewTab ? 'noopener noreferrer' : undefined}
                >
                  <div class="archive__media">
                    <img src={project.cover} alt="" loading="lazy" />
                  </div>
                  <div class="archive__copy">
                    <p class="archive__serial vf-mono">
                      {serial}
                      {project.featured && <span> · featured</span>}
                      <span> · {project.role}</span>
                      <span> · {project.period}</span>
                    </p>
                    <h2 class="archive__name vf-display">{project.title}</h2>
                    <p class="archive__desc vf-serif">{project.desc}</p>
                    <p class="archive__detail vf-serif">{project.detail}</p>
                    {project.metrics && (
                      <p class="archive__metrics vf-mono">{project.metrics.join(' · ')}</p>
                    )}
                    <p class="archive__tech vf-mono">{project.tech.join(' · ')}</p>
                    <span class="archive__cta vf-mono">open project →</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </main>
      <SiteFoot />
    </div>
    <div class="site-contrast-mask js-contrast-mask" aria-hidden="true"></div>
    <script>
      const btn = document.querySelector('.js-contrast');
      const mask = document.querySelector('.js-contrast-mask');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = !root.classList.contains('theme-contrasted');
        if (mask) {
          (mask as HTMLElement).style.transform = 'translate3d(0,0,0)';
          requestAnimationFrame(() => {
            root.classList.toggle('theme-contrasted', next);
            localStorage.setItem('vf-theme', next ? 'contrasted' : 'default');
            setTimeout(() => {
              (mask as HTMLElement).style.transform = 'translate3d(100%,0,0)';
              setTimeout(() => {
                (mask as HTMLElement).style.transform = 'translate3d(-100%,0,0)';
              }, 280);
            }, 40);
          });
        } else {
          root.classList.toggle('theme-contrasted', next);
          localStorage.setItem('vf-theme', next ? 'contrasted' : 'default');
        }
      });
      if (localStorage.getItem('vf-theme') === 'contrasted') {
        document.documentElement.classList.add('theme-contrasted');
      }
      document.documentElement.classList.remove('is-scroll-blocked');
    </script>
    <Analytics />
  </body>
</html>

<style>
  .archive {
    text-align: left;
  }
  .archive__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 2.25rem var(--vf-pad) 1.75rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    margin: 0 auto;
  }
  .archive__head-copy {
    display: grid;
    gap: 0.45rem;
  }
  .archive__title {
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5rem);
    overflow-wrap: normal;
    word-break: normal;
  }
  .archive__lede {
    margin: 0.35rem 0 0;
    font-size: 1.35rem;
    max-width: 40rem;
  }
  .archive__back {
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--vf-mark);
    min-height: var(--vf-tap);
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid var(--vf-mark);
  }
  .archive__list {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--vf-pad) 3.5rem;
    max-width: calc(var(--vf-max) + 2 * var(--vf-pad));
    display: grid;
    gap: 1.5rem;
  }
  .archive__row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding: 1.35rem;
    border: 1px solid var(--vf-line);
    background: color-mix(in srgb, var(--vf-ink) 4%, transparent);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, transform 0.25s;
  }
  .archive__row:hover {
    border-color: color-mix(in srgb, var(--vf-mark) 55%, var(--vf-line));
    transform: translateY(-3px);
  }
  .archive__row:hover .archive__name,
  .archive__row:hover .archive__cta {
    color: var(--vf-mark);
  }
  .archive__copy {
    min-width: 0;
    display: grid;
    gap: 0.45rem;
    justify-items: start;
  }
  .archive__serial {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--vf-mark);
  }
  .archive__name {
    margin: 0;
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    line-height: 1.1;
    overflow-wrap: normal;
    word-break: normal;
    text-wrap: balance;
  }
  .archive__desc {
    margin: 0.2rem 0 0;
    max-width: none;
    font-size: 1.25rem;
  }
  .archive__detail {
    margin: 0.15rem 0 0;
    max-width: none;
    opacity: 0.88;
    font-size: 1.1rem;
  }
  .archive__metrics {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--vf-mark);
  }
  .archive__tech {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .archive__cta {
    margin-top: 0.55rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.1rem;
  }
  .archive__media {
    border: 1px solid var(--vf-ink);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    width: 100%;
    max-width: none;
  }
  .archive__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .archive__row:hover .archive__media img {
    transform: scale(1.04);
  }

  @media (max-width: 860px) {
    .archive__row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .archive__head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 720px) {
    .archive__row {
      padding: 1rem;
    }
    .archive__name {
      font-size: 1.7rem;
    }
    .archive__desc,
    .archive__detail {
      font-size: 1.15rem;
    }
  }
</style>
