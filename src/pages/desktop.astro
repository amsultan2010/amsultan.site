---
import { AstroSeo } from '@astrolib/seo';
import Analytics from '@vercel/analytics/astro';
import DesktopShell from '../components/desktop/DesktopShell';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <meta name="author" content="Abdullah Sultan" />

    <AstroSeo
      title="Abdullah OS — Interactive Desktop"
      description="An interactive macOS-themed desktop environment showcasing Abdullah Sultan's portfolio"
      canonical="https://abdullahmsultan.me"
      openGraph={{
        url: 'https://abdullahmsultan.me',
        title: 'Abdullah OS — Interactive Desktop',
        description: 'An interactive macOS-themed desktop environment showcasing Abdullah Sultan\'s portfolio',
        site_name: 'Abdullah Sultan',
        images: [{ url: 'https://abdullahmsultan.me/og.jpg', width: 1200, height: 630, alt: 'Abdullah Sultan portfolio' }],
      }}
    />

    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/abdullah-apple-touch.png" />
    <meta name="theme-color" content="#0b1220" />

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: #0b1220;
        overflow-x: hidden;
        max-width: 100vw;
        min-height: 100vh;
      }

      body {
        margin: 0;
        min-width: 320px;
        width: 100%;
        background: transparent;
        overflow-x: hidden;
        min-height: 100vh;
        min-height: 100dvh;
      }

      @media (min-width: 769px) {
        body {
          display: flex;
          place-items: center;
        }
      }

      ::-webkit-scrollbar {
        width: 0px;
        background: transparent;
      }

      canvas {
        display: block !important;
        max-width: 100% !important;
        max-height: 100% !important;
      }

      a {
        color: #646cff;
        text-decoration: inherit;
      }
      a:hover {
        color: #535bf2;
      }
    </style>
      <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://abdullahmsultan.me/og.jpg" />
  </head>
  <body>
    <DesktopShell client:only="react" />
    <Analytics />
  </body>
</html>
