---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteScrollbar from '../components/SiteScrollbar.astro'
import Hero from '../components/Hero.astro'
import SeparatorStrip from '../components/SeparatorStrip.astro'
import StretchWord from '../components/StretchWord.astro'
import About from '../components/About.astro'
import Work from '../components/Work.astro'
import Proof from '../components/Proof.astro'
import Photos from '../components/Photos.astro'
import Contact from '../components/Contact.astro'

import '../styles/global.scss'
---

<html lang="en" class="is-scroll-blocked">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>abdullah sultan · student builder</title>
    <meta
      name="description"
      content="student builder in riyadh. tutoring, f1 media, and quant tools."
    />
    <link rel="canonical" href="https://www.abdullahmsultan.me/" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="abdullah sultan · student builder" />
    <meta
      property="og:description"
      content="student builder in riyadh. tutoring, f1 media, and quant tools."
    />
    <meta property="og:url" content="https://www.abdullahmsultan.me/" />
    <meta property="og:site_name" content="abdullah sultan" />
    <meta property="og:image" content="https://www.abdullahmsultan.me/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.abdullahmsultan.me/og.jpg" />

    <meta name="theme-color" content="#ff4d1a" />
    <meta name="msapplication-navbutton-color" content="#ff4d1a" />
    <meta name="apple-mobile-web-app-status-bar-style" content="#ff4d1a" />

    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <link rel="apple-touch-icon" href="/icons/abdullah-apple-touch.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Unbounded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="site-progress js-progress" aria-hidden="true"></div>
    <div class="site-cursor js-cursor" aria-hidden="true">
      <span class="site-cursor__ring js-cursor-ring"></span>
      <span class="site-cursor__dot js-cursor-dot"></span>
    </div>
    <div class="site-noise js-noise" aria-hidden="true"></div>
    <div class="site-frame" aria-hidden="true"></div>

    <div class="site-terrain js-terrain" aria-hidden="true">
      <div class="site-terrain__fallback"></div>
      <canvas class="js-terrain-canvas"></canvas>
    </div>

    <div id="top" class="site-wrapper js-site-wrapper" style="opacity: 0;">
      <SiteHeader />
      <main>
        <Hero />
        <SeparatorStrip phrases={['about', 'riyadh', 'student', 'builder']} style="secondary" />
        <StretchWord word="about" />
        <About />
        <SeparatorStrip phrases={['tutoringbyabdullah', 'downforce', 'quantpy']} reverse />
        <StretchWord word="work" />
        <Work />
        <SeparatorStrip phrases={['x-combinator', 'debate', 'tennis', 'stack']} style="secondary" />
        <StretchWord word="proof" />
        <Proof />
        <SeparatorStrip phrases={['photos', 'f1', 'tennis', 'weightlifting']} reverse />
        <StretchWord word="photos" />
        <Photos />
        <SeparatorStrip phrases={['email', 'github', 'linkedin', 'resume']} style="secondary" />
        <StretchWord word="talk" />
        <Contact />
      </main>
      <SiteFooter />
    </div>

    <div class="site-intro js-intro">
      <div class="site-intro__panel js-intro-panel" aria-hidden="true"></div>
      <div class="site-intro__border site-intro__border--top js-intro-border-t"></div>
      <div class="site-intro__border site-intro__border--left js-intro-border-l"></div>
      <div class="site-intro__border site-intro__border--right js-intro-border-r"></div>
      <p class="site-intro__mark js-intro-mark">abdullah sultan</p>
      <button type="button" class="site-intro__skip js-intro-skip">skip</button>
    </div>

    <SiteScrollbar />
    <div class="site-contrast-mask js-contrast-mask" aria-hidden="true"></div>

    <script>
      import { initVoltageMotion } from '../scripts/voltage-motion'
      initVoltageMotion()
    </script>
    <script>
      import { inject } from '@vercel/analytics'
      inject()
    </script>
  </body>
</html>
