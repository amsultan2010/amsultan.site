---
import { AstroSeo } from '@astrolib/seo';
import Analytics from '@vercel/analytics/astro';
import SiteHead from '../components/site/SiteHead.astro';
import SiteFoot from '../components/site/SiteFoot.astro';
import SHero from '../components/site/SHero.astro';
import SAbout from '../components/site/SAbout.astro';
import SWork from '../components/site/SWork.astro';
import SProof from '../components/site/SProof.astro';
import SMargin from '../components/site/SMargin.astro';
import SContact from '../components/site/SContact.astro';
import ASeparator from '../components/site/ASeparator.astro';
import SStretch from '../components/site/SStretch.astro';
import '../styles/voltage.css';
---

<html lang="en" class="is-scroll-blocked">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Abdullah Sultan" />

    <AstroSeo
      title="abdullah sultan · student builder"
      description="student builder in riyadh. shipping tutoring, f1 media, and agent tools."
      canonical="https://abdullahmsultan.me"
      openGraph={{
        url: 'https://abdullahmsultan.me',
        title: 'abdullah sultan · student builder',
        description: 'student builder in riyadh. shipping tutoring, f1 media, and agent tools.',
        site_name: 'abdullah sultan',
        images: [{ url: 'https://abdullahmsultan.me/og.jpg', width: 1200, height: 630, alt: 'abdullah sultan portfolio' }],
      }}
    />

    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/abdullah-apple-touch.png" />
    <meta name="theme-color" content="#ff4d1a" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Unbounded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://abdullahmsultan.me/og.jpg" />
  </head>
  <body>
    <div class="site-progress js-progress" aria-hidden="true"></div>
    <div class="site-cursor js-cursor" aria-hidden="true">
      <span class="site-cursor__ring js-cursor-ring"></span>
      <span class="site-cursor__dot js-cursor-dot"></span>
    </div>
    <div class="site-noise js-noise" aria-hidden="true"></div>

    <div class="site-terrain js-terrain" aria-hidden="true">
      <div class="site-terrain__fallback"></div>
      <canvas class="js-terrain-canvas"></canvas>
    </div>

    <div id="top" class="site-wrapper js-site-wrapper" style="opacity: 0;">
      <SiteHead />
      <main>
        <SHero />
        <ASeparator phrases={['about', 'riyadh', 'student', 'builder']} />
        <SStretch word="about" />
        <SAbout />
        <ASeparator phrases={['tutoringbyabdullah', 'downforce', 'quantpy', 'lab']} reverse />
        <SStretch word="work" />
        <SWork />
        <ASeparator phrases={['x-combinator', 'debate', 'tennis', 'stack']} />
        <SStretch word="proof" />
        <SProof />
        <ASeparator phrases={['photos', 'f1', 'tennis', 'weightlifting']} reverse />
        <SStretch word="photos" />
        <SMargin />
        <ASeparator phrases={['email', 'github', 'linkedin', 'resume']} />
        <SStretch word="talk" />
        <SContact />
      </main>
      <SiteFoot />
    </div>

    <div class="site-intro js-intro">
      <div class="site-intro__panel js-intro-panel" aria-hidden="true"></div>
      <p class="site-intro__mark js-intro-mark">abdullah sultan</p>
      <button type="button" class="site-intro__skip js-intro-skip">skip</button>
    </div>

    <div class="site-contrast-mask js-contrast-mask" aria-hidden="true"></div>

    <script src="../scripts/site.ts"></script>
    <Analytics />
  </body>
</html>
