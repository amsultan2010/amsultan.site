---
import { AstroSeo } from '@astrolib/seo';
import Analytics from '@vercel/analytics/astro';
import LabApp from '../components/lab/LabApp';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Abdullah Sultan" />

    <AstroSeo
      title="The Lab — Abdullah Sultan"
      description="Interactive playground: ASCII instrument, chronograph, terminal easter egg."
      canonical="https://abdullahmsultan.me/lab"
      openGraph={{
        url: 'https://abdullahmsultan.me/lab',
        title: 'The Lab — Abdullah Sultan',
        description: 'Interactive playground: ASCII instrument, chronograph, terminal easter egg.',
        site_name: 'Abdullah Sultan',
        images: [{ url: 'https://abdullahmsultan.me/og.jpg', width: 1200, height: 630, alt: 'Abdullah Sultan portfolio' }],
      }}
    />

    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/abdullah-apple-touch.png" />
    <meta name="theme-color" content="#0e1116" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="preload" href="/NeueMontreal-Medium.otf" as="font" type="font/otf" crossorigin />

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html {
        background-color: #0e1116;
        overflow-x: hidden;
        max-width: 100vw;
        min-height: 100vh;
      }
      body {
        margin: 0;
        min-width: 320px;
        background: transparent;
        overflow-x: hidden;
        min-height: 100vh;
        width: 100%;
        font-family: 'NeueMontreal', 'Avenir Next', sans-serif;
      }
      a { color: inherit; text-decoration: inherit; }
    </style>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://abdullahmsultan.me/og.jpg" />
  </head>
  <body>
    <LabApp client:only="react" />
    <Analytics />
  </body>
</html>
