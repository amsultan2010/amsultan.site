---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { PROJECTS } from '@/data/projects'

import '../styles/global.scss'

const total = String(PROJECTS.length).padStart(2, '0')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>projects | abdullah sultan</title>
    <meta
      name="description"
      content="archive of shipped work: tutoring, f1 media, and quant tools."
    />
    <link rel="canonical" href="https://www.abdullahmsultan.me/projects" />
    <meta property="og:title" content="projects | abdullah sultan" />
    <meta
      property="og:description"
      content="archive of shipped work: tutoring, f1 media, and quant tools."
    />
    <meta property="og:url" content="https://www.abdullahmsultan.me/projects" />
    <meta name="theme-color" content="#ff4d1a" />
    <link rel="icon" type="image/png" href="/icons/abdullah-favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Unbounded:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-wrapper" style="opacity: 1;">
      <SiteHeader />
      <main class="archive">
        <header class="archive__head">
          <div class="archive__head-copy">
            <p class="vf-band">archive</p>
            <h1 class="archive__title vf-display">projects</h1>
            <p class="archive__lede vf-serif">
              tutoring, f1 media, and quant tools. {PROJECTS.length} shipped.
            </p>
          </div>
          <a href="/#work" class="archive__back vf-mono">← back to work</a>
        </header>

        <ul class="archive__list">
          {
            PROJECTS.map((project, i) => {
              const href = project.demo || project.href
              const external = href.startsWith('http')
              const serial = `${String(i + 1).padStart(2, '0')} / ${total}`
              const openNew = external || project.demoNewTab
              return (
                <li>
                  <a
                    class="archive__row"
                    href={href}
                    target={openNew ? '_blank' : undefined}
                    rel={openNew ? 'noopener noreferrer' : undefined}
                  >
                    <div class="archive__media">
                      <img src={project.cover} alt="" loading="lazy" />
                    </div>
                    <div class="archive__copy">
                      <p class="archive__serial vf-mono">
                        {serial}
                        {project.featured && <span> · featured</span>}
                        <span> · {project.role}</span>
                        <span> · {project.period}</span>
                      </p>
                      <h2 class="archive__name vf-display">{project.title}</h2>
                      <p class="archive__desc vf-serif">{project.desc}</p>
                      <p class="archive__detail vf-serif">{project.detail}</p>
                      {project.metrics && (
                        <p class="archive__metrics vf-mono">{project.metrics.join(' · ')}</p>
                      )}
                      <p class="archive__tech vf-mono">{project.tech.join(' · ')}</p>
                      <span class="archive__cta vf-mono">open project →</span>
                    </div>
                  </a>
                </li>
              )
            })
          }
        </ul>
      </main>
      <SiteFooter />
    </div>

    <script>
      const btn = document.querySelector('.js-contrast')
      btn?.addEventListener('click', () => {
        const root = document.documentElement
        const next = !root.classList.contains('theme-contrasted')
        root.classList.toggle('theme-contrasted', next)
        localStorage.setItem('vf-theme', next ? 'contrasted' : 'default')
      })
      if (localStorage.getItem('vf-theme') === 'contrasted') {
        document.documentElement.classList.add('theme-contrasted')
      }
    </script>
  </body>
</html>
