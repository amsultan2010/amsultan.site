{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/desktop/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lab",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lab/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fitness",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pictures",
      "destination": "/#margin",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
