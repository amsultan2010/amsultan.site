{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/resume.html",
      "destination": "/resume",
      "permanent": true
    },
    {
      "source": "/desktop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/desktop/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lab",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lab/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fitness",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pictures",
      "destination": "/#margin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/resume.pdf"
    }
  ],
  "headers": [
    {
      "source": "/resume(.pdf)?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Abdullah_Sultan_Resume.pdf\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
